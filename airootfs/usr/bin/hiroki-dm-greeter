#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Hiroki OS Display Manager - Grafik Karşılama (Greeter).

X oturumu içinde çalışır (root). Kullanıcı adı + parola ile PAM üzerinden
kimlik doğrular, oturum (masaüstü) seçimini alır ve sonucu /run/hiroki/login.info
dosyasına yazar, ardından çıkar. hiroki-dm orkestratörü bu dosyayı okuyup
oturumu başlatır.

Rol:
  - login   : giriş başarılı, oturum başlatılacak
  - shutdown: güç kapat
  - reboot  : yeniden başlat
"""
import gi
import os
import sys

gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, Pango

INFO = "/run/hiroki/login.info"
SELECTED_DE = "/etc/hiroki/selected-de"
DEFAULT_DE = "xfce"

# (anahtar, görünen ad, session komutu) -- hiroki-dm-xinit ile uyumlu anahtarlar
SESSIONS = [
    ("xfce", "XFCE", "startxfce4"),
    ("kde", "KDE Plasma", "startkde"),
    ("gnome", "GNOME", "gnome-session"),
    ("mate", "MATE", "mate-session"),
    ("cinnamon", "Cinnamon", "cinnamon-session"),
    ("budgie", "Budgie", "budgie-session"),
    ("lxqt", "LXQt", "startlxqt"),
    ("i3wm", "i3wm", "i3"),
    ("openbox", "Openbox", "openbox-session"),
    ("hyprland", "Hyprland (Wayland)", "hyprland"),
]
SESSION_KEYS = [k for k, _, _ in SESSIONS]


def read_selected_de():
    try:
        with open(SELECTED_DE) as fh:
            de = fh.read().strip()
        if de in SESSION_KEYS:
            return de
    except Exception:
        pass
    return DEFAULT_DE


def write_selected_de(de):
    try:
        os.makedirs(os.path.dirname(SELECTED_DE), exist_ok=True)
        with open(SELECTED_DE, "w") as fh:
            fh.write(de + "\n")
        return True
    except Exception:
        return False


def write_login_info(user, session, action):
    os.makedirs(os.path.dirname(INFO), exist_ok=True)
    with open(INFO, "w") as fh:
        fh.write("USER=%s\n" % user)
        fh.write("SESSION=%s\n" % session)
        fh.write("ACTION=%s\n" % action)


def authenticate(username, password):
    if not username or not password:
        return False
    try:
        import pam
    except Exception:
        return False
    try:
        p = pam.pam()
    except Exception:
        return False
    try:
        return bool(p.authenticate(username, password, service="login"))
    except TypeError:
        try:
            return bool(p.authenticate(username, password))
        except Exception:
            return False
    except Exception:
        return False


class HirokiGreeter(Gtk.Window):
    def __init__(self):
        super().__init__(title="Hiroki OS")
        self.set_default_size(680, 460)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.fullscreen()
        self.connect("destroy", self.on_cancel)
        self.set_border_width(0)
        self.build_ui()
        self.present()

    def build_ui(self):
        # Koyu tema arka plan (CSS)
        css = b"""
        .hiroki-greeter {
            background-color: rgba(13, 13, 26, 0.96);
            border-radius: 14px;
        }
        window.hiroki-greeter-window {
            background-color: #1A1A2E;
        }
        """
        try:
            provider = Gtk.CssProvider()
            provider.load_from_data(css)
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(), provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        except Exception:
            pass

        # Tek içerik kutusu (duvar kağıdı olmadan sade, sağlam stil)
        overlay = Gtk.Overlay()
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        content.set_valign(Gtk.Align.CENTER)
        content.set_halign(Gtk.Align.CENTER)
        content.set_hexpand(False)
        content.set_vexpand(False)
        content.get_style_context().add_class("hiroki-greeter")
        content.set_margin_top(28)
        content.set_margin_bottom(28)
        content.set_margin_start(56)
        content.set_margin_end(56)

        # Logo / başlık
        title = Gtk.Label()
        title.set_markup('<span size="x-large" weight="bold" foreground="#EAEAEA">🌸 Hiroki OS</span>')
        content.pack_start(title, False, False, 0)
        sub = Gtk.Label()
        sub.set_markup('<span size="medium" foreground="#A0A0B8">Sakura 1.0 — Oturumunu seç ve giriş yap</span>')
        content.pack_start(sub, False, False, 0)

        # Kullanıcı adı
        self.username = Gtk.Entry()
        self.username.set_width_chars(28)
        self.username.set_placeholder_text("Kullanıcı adı")
        content.pack_start(self.username, False, False, 6)

        # Parola
        self.password = Gtk.Entry()
        self.password.set_visibility(False)
        self.password.set_placeholder_text("Parola")
        self.password.connect("activate", lambda w: self.on_login(None))
        content.pack_start(self.password, False, False, 6)

        # Oturum seçimi
        self.session = Gtk.ComboBoxText()
        for key, name, _ in SESSIONS:
            self.session.append(key, name)
        self.session.set_active(SESSION_KEYS.index(read_selected_de()))
        content.pack_start(self.session, False, False, 6)

        # Hata alanı
        self.error = Gtk.Label()
        self.error.set_markup("<span foreground=\"#ff6666\"></span>")
        self.error.set_line_wrap(True)
        content.pack_start(self.error, False, False, 0)

        # Butonlar
        btnrow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btnrow.set_halign(Gtk.Align.CENTER)
        b_login = Gtk.Button(label="Giriş Yap")
        b_login.get_style_context().add_class("suggested-action")
        b_login.connect("clicked", self.on_login)
        b_power = Gtk.Button(label="Kapat")
        b_power.connect("clicked", lambda w: self.stop("shutdown"))
        b_reboot = Gtk.Button(label="Yeniden Başlat")
        b_reboot.connect("clicked", lambda w: self.stop("reboot"))
        for b in (b_login, b_power, b_reboot):
            btnrow.pack_start(b, False, False, 0)
        content.pack_start(btnrow, False, False, 10)

        overlay.add_overlay(content)
        self.add(overlay)

        self.connect("size-allocate", lambda *a: True)
        self.show_all()
        self.username.grab_focus()

    def show_error(self, msg):
        self.error.set_markup("<span foreground=\"#ff6666\">⚠ %s</span>" % msg)
        self.show_all()

    def on_login(self, _btn):
        user = self.username.get_text().strip()
        pw = self.password.get_text()
        de = self.session.get_active_id() or DEFAULT_DE
        if not user:
            self.show_error("Kullanıcı adı boş olamaz.")
            return
        if not pw:
            self.show_error("Parola boş olamaz.")
            return
        if not authenticate(user, pw):
            self.show_error("Şifre hatalı veya kullanıcı bulunamadı.")
            self.password.select_region(0, -1)
            self.password.grab_focus()
            return
        write_selected_de(de)
        write_login_info(user, de, "login")
        sys.exit(0)

    def stop(self, action):
        write_login_info("", "", action)
        sys.exit(0)

    def on_cancel(self, _w):
        # pencere kapatılırsa (ESC) iptal: greeter yeniden gösterilecek
        write_login_info("", "", "cancel")
        sys.exit(0)


def main():
    # root değilsek yine de çalıştır; PAM için root gerekir
    gtk = HirokiGreeter()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
