    def _make_separator(self):
        sep = QFrame()
        sep.setFrameShape(QFrame.Shape.HLine)
        sep.setStyleSheet(f"background-color: {BORDER_COLOR}; max-height: 1px;")
        return sep

    def _load_categories(self):
        categories = [
            ("Plasma", "🖥️"),
            ("Renk", "🎨"),
            ("Icon", "📁"),
            ("Cursor", "🖱️"),
            ("Font", "🔤"),
        ]
        self.category_list.clear()
        for name, icon in categories:
            item = QListWidgetItem(f"  {icon}  {name}")
            item.setData(Qt.ItemDataRole.UserRole, name)
            self.category_list.addItem(item)

    def _on_category_changed(self, row):
        if row < 0:
            return
        item = self.category_list.item(row)
        if item:
            cat = item.data(Qt.ItemDataRole.UserRole)
            self._select_category(cat)

    def _select_category(self, category):
        self.current_category = category

        # Baslik guncelle
        cat_display = {
            "Plasma": "Plasma Tema",
            "Renk": "Renk Sema",
            "Icon": "Ikon Tema",
            "Cursor": "Cursor Tema",
            "Font": "Font Secimi",
        }
        self.category_title.setText(cat_display.get(category, category))

        # Mevcut temayi al
        current = self._get_current_theme(category)
        self.current_theme_label.setText(f"Mevcut: {current}")

        # Temalari yukle
        self.theme_list.clear()

        # Varsayilan ekle
        varsayilan = QListWidgetItem("⭐ Varsayilan")
        varsayilan.setData(Qt.ItemDataRole.UserRole, "Varsayilan")
        self.theme_list.addItem(varsayilan)

        if category == "Font":
            themes = get_installed_fonts()
        else:
            themes = get_installed_themes(category)

        for theme in themes:
            display = theme
            if theme == current:
                display = f"✅  {theme}  (aktif)"
            item = QListWidgetItem(display)
            item.setData(Qt.ItemDataRole.UserRole, theme)
            self.theme_list.addItem(item)

        # Mevcut temayi sec
        for i in range(self.theme_list.count()):
            item = self.theme_list.item(i)
            if item.data(Qt.ItemDataRole.UserRole) == current:
                self.theme_list.setCurrentItem(item)
                break

    def _get_current_theme(self, category):
        if category == "Plasma":
            return get_current_plasma_theme()
        elif category == "Renk":
            return get_current_color_scheme()
        elif category == "Icon":
            return get_current_icon_theme()
        elif category == "Cursor":
            return get_current_cursor_theme()
        elif category == "Font":
            return get_current_font()
        return "Bilinmiyor"

    def _on_theme_selected(self, current, previous):
        if current:
            theme_name = current.data(Qt.ItemDataRole.UserRole)
            self.apply_btn.setEnabled(True)
        else:
            self.apply_btn.setEnabled(False)

    def _apply_selected_theme(self):
        item = self.theme_list.currentItem()
        if not item:
            return

        theme_name = item.data(Qt.ItemDataRole.UserRole)
        if not theme_name:
            return

        if theme_name == "Varsayilan":
            reply = QMessageBox.question(
                self,
                "Onay",
                f"{self.current_category} kategorisinde varsayilan temaya donmek istediginize emin misiniz?",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
                QMessageBox.StandardButton.No
            )
            if reply != QMessageBox.StandardButton.Yes:
                return
            # Varsayilan tema icin komut
            defaults = {
                "Plasma": "breeze",
                "Renk": "Breeze",
                "Icon": "breeze",
                "Cursor": "breeze",
                "Font": "Noto Sans",
            }
            theme_name = defaults.get(self.current_category, "breeze")

        self.apply_btn.setEnabled(False)
        self.apply_btn.setText("Uygulanıyor...")
        QApplication.processEvents()

        success, message = apply_theme(self.current_category, theme_name)

        self.apply_btn.setText("Uygula")
        self.apply_btn.setEnabled(True)

        if success:
            QMessageBox.information(
                self,
                "Basarili",
                f"{message}\nDegisikliklerin tam gecerli olmasi icin oturumu yeniden baslatabilirsiniz.",
                QMessageBox.StandardButton.Ok
            )
            self._select_category(self.current_category)
        else:
            QMessageBox.critical(
                self,
                "Hata",
                f"Tema uygulanirken hata olustu:\n{message}",
                QMessageBox.StandardButton.Ok
            )

    def _refresh(self):
        self._select_category(self.current_category)


def main():
    app = QApplication(sys.argv)
    app.setStyle("Fusion")

    palette = QPalette()
    palette.setColor(QPalette.ColorRole.Window, QColor(BG_COLOR))
    palette.setColor(QPalette.ColorRole.WindowText, QColor(TEXT_PRIMARY))
    palette.setColor(QPalette.ColorRole.Base, QColor(BG_TERTIARY))
    palette.setColor(QPalette.ColorRole.AlternateBase, QColor(BG_SECONDARY))
    palette.setColor(QPalette.ColorRole.ToolTipBase, QColor(BG_SECONDARY))
    palette.setColor(QPalette.ColorRole.ToolTipText, QColor(TEXT_PRIMARY))
    palette.setColor(QPalette.ColorRole.Text, QColor(TEXT_PRIMARY))
    palette.setColor(QPalette.ColorRole.Button, QColor(BG_TERTIARY))
    palette.setColor(QPalette.ColorRole.ButtonText, QColor(TEXT_PRIMARY))
    palette.setColor(QPalette.ColorRole.BrightText, QColor(ACCENT_COLOR))
    palette.setColor(QPalette.ColorRole.Link, QColor(ACCENT_COLOR))
    palette.setColor(QPalette.ColorRole.Highlight, QColor(ACCENT_COLOR))
    palette.setColor(QPalette.ColorRole.HighlightedText, QColor(TEXT_PRIMARY))
    app.setPalette(palette)

    window = HirokiThemeManager()
    window.show()

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
