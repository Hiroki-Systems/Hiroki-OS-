# === Sabit Degerler ===
VERSION = "1.0.0"
BG_COLOR = "#111111"
BG_SECONDARY = "#1a1a1a"
BG_TERTIARY = "#222222"
ACCENT_COLOR = "#d34188"
ACCENT_HOVER = "#e5539a"
TEXT_PRIMARY = "#ffffff"
TEXT_SECONDARY = "#aaaaaa"
BORDER_COLOR = "#333333"

KDE_USER_DIRS = {
    "Plasma": ["~/.local/share/plasma/desktoptheme/"],
    "Renk": ["~/.local/share/color-schemes/"],
    "Icon": ["~/.local/share/icons/"],
    "Cursor": ["~/.local/share/icons/", "~/.local/share/cursors/"],
    "Font": ["~/.local/share/fonts/", "~/.local/share/fonts/truetype/"],
}

KDE_SYSTEM_DIRS = {
    "Plasma": ["/usr/share/plasma/desktoptheme/"],
    "Renk": ["/usr/share/color-schemes/"],
    "Icon": ["/usr/share/icons/"],
    "Cursor": ["/usr/share/icons/", "/usr/share/cursors/"],
    "Font": ["/usr/share/fonts/"],
}


def expand_path(path):
    return os.path.expanduser(path)


def list_directories(path):
    """Dizin icerigini listele (sadece dizinler)."""
    expanded = expand_path(path)
    if not os.path.isdir(expanded):
        return []
    try:
        entries = []
        for name in sorted(os.listdir(expanded)):
            full = os.path.join(expanded, name)
            if os.path.isdir(full):
                entries.append(name)
        return entries
    except PermissionError:
        return []


def list_files_with_ext(path, extensions):
    """Dizin icerisindeki belirli uzantili dosyalari listele."""
    expanded = expand_path(path)
    if not os.path.isdir(expanded):
        return []
    try:
        entries = []
        for name in sorted(os.listdir(expanded)):
            if any(name.endswith(ext) for ext in extensions):
                stem = os.path.splitext(name)[0]
                entries.append(stem)
        return entries
    except PermissionError:
        return []


def list_font_files(path):
    """Font dosyalarini listele."""
    extensions = (".ttf", ".otf", ".woff", ".woff2", ".fon")
    return list_files_with_ext(path, extensions)


def get_current_plasma_theme():
    """Mevcut Plasma temasini al."""
    try:
        result = subprocess.run(
            ["plasma-apply-desktoptheme", "--list"],
            capture_output=True, text=True, timeout=5
        )
        for line in result.stdout.splitlines():
            if line.startswith("*"):
                return line.replace("*", "").strip()
    except Exception:
        pass
    try:
        result = subprocess.run(
            ["kf5-config", "--globals"],
            capture_output=True, text=True, timeout=5
        )
        for line in result.stdout.splitlines():
            if "Theme=" in line:
                return line.split("Theme=", 1)[-1].strip()
    except Exception:
        pass
    return "Bilinmiyor"


