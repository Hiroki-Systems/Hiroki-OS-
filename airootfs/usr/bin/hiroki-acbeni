#!/usr/bin/env python3
"""Hiroki OS - Ac Beni (Gist Okuyucu)"""
import sys, urllib.request

GIST_URL = "https://gist.githubusercontent.com/kuzkuz5353-source/db117dba689d1bb4f57db655eb375e43/raw/gistfile1.txt"

def fetch():
    try:
        req = urllib.request.Request(GIST_URL, headers={"User-Agent": "HirokiOS/1.0"})
        with urllib.request.urlopen(req, timeout=10) as resp:
            return resp.read().decode("utf-8").strip()
    except Exception as e:
        return f"Okunamadi: {e}"

def main():
    text = fetch()
    if text == "1" or not text:
        text = "Henuz bir sey yazilmamis..."

    try:
        from PyQt6.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout,
                                      QLabel, QTextEdit, QFrame)
        from PyQt6.QtCore import Qt
        from PyQt6.QtGui import QFont

        app = QApplication(sys.argv)
        app.setStyle("Fusion")

        win = QMainWindow()
        win.setWindowTitle("Ac Beni")
        win.setMinimumSize(650, 500)

        central = QWidget()
        win.setCentralWidget(central)
        layout = QVBoxLayout(central)
        layout.setContentsMargins(30, 30, 30, 30)

        title = QLabel("Ac Beni")
        title.setFont(QFont("Sans Serif", 20, QFont.Weight.Bold))
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        title.setStyleSheet("color: #d34188; margin-bottom: 15px;")
        layout.addWidget(title)

        line = QFrame()
        line.setFrameShape(QFrame.Shape.HLine)
        line.setStyleSheet("color: #333;")
        layout.addWidget(line)

        viewer = QTextEdit()
        viewer.setReadOnly(True)
        viewer.setText(text)
        viewer.setStyleSheet("""
            background-color: #1a1a1a;
            color: #ccc;
            border: 1px solid #333;
            border-radius: 8px;
            font-size: 13px;
            padding: 15px;
        """)
        layout.addWidget(viewer)

        win.setStyleSheet("background-color: #111;")
        win.show()
        sys.exit(app.exec())
    except ImportError:
        print(f"\n\033[1;35m--- Ac Beni ---\033[0m\n")
        print(text)

if __name__ == "__main__":
    main()
