#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# Hiroki OS - Sürücü Yöneticisi (mhwd benzeri, Arch paketleri)
import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GLib
import subprocess, re

class HirokiDriverManager(Gtk.Window):
    def __init__(self):
        super().__init__(title="Hiroki Sürücü Yöneticisi")
        self.set_default_size(680, 480)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.connect("destroy", Gtk.main_quit)
        self.build_ui()
        self.detect()

    def build_ui(self):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        vbox.set_margin_top(12); vbox.set_margin_bottom(12); vbox.set_margin_start(12); vbox.set_margin_end(12)
        self.add(vbox)
        vbox.pack_start(Gtk.Label(label="<b>🔧 Hiroki Sürücü Yöneticisi</b> — Eksik sürücüleri tespit eder ve kurar"), False, False, 0)
        self.info = Gtk.Label()
        self.info.set_line_wrap(True)
        vbox.pack_start(self.info, False, False, 0)
        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        scroll.add(self.listbox)
        vbox.pack_start(scroll, True, True, 0)
        hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        hbox.set_halign(Gtk.Align.END)
        btn_detect = Gtk.Button(label="Yeniden Tara")
        btn_detect.connect("clicked", lambda w: self.detect())
        btn_close = Gtk.Button(label="Kapat")
        btn_close.connect("clicked", lambda w: self.destroy())
        hbox.pack_start(btn_detect, False, False, 0)
        hbox.pack_start(btn_close, False, False, 0)
        vbox.pack_start(hbox, False, False, 0)

    def add_driver_row(self, title, desc, pkg, installed):
        row = Gtk.ListBoxRow()
        hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        hbox.set_margin_top(8); hbox.set_margin_bottom(8); hbox.set_margin_start(8); hbox.set_margin_end(8)
        icon = Gtk.Label(label="✅" if installed else "⬜")
        hbox.pack_start(icon, False, False, 0)
        txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        t = Gtk.Label()
        t.set_markup(f'<b>{title}</b>  <span color="#A0A0B8">({pkg})</span>')
        t.set_halign(Gtk.Align.START)
        d = Gtk.Label(label=desc)
        d.set_halign(Gtk.Align.START)
        d.set_line_wrap(True)
        txt.pack_start(t, False, False, 0)
        txt.pack_start(d, False, False, 0)
        hbox.pack_start(txt, True, True, 0)
        if not installed:
            btn = Gtk.Button(label="Kur")
            btn.get_style_context().add_class("suggested-action")
            btn.connect("clicked", self.on_install, pkg)
            hbox.pack_end(btn, False, False, 0)
        else:
            lbl = Gtk.Label(label="Kurulu")
            lbl.set_markup('<span color="#00D4AA"><b>Kurulu</b></span>')
            hbox.pack_end(lbl, False, False, 0)
        row.add(hbox)
        self.listbox.add(row)

    def is_installed(self, pkg):
        return subprocess.run(["pacman","-Q",pkg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

    def detect(self):
        for c in self.listbox.get_children():
            self.listbox.remove(c)
        # lspci
        try:
            lspci = subprocess.check_output(["lspci"], text=True)
        except:
            lspci = ""
        lower = lspci.lower()
        self.info.set_text(lspci.splitlines()[0] if lspci else " lspci bulunamadı ")
        # GPU
        if "nvidia" in lower:
            self.add_driver_row("NVIDIA Sürücüsü", "Kapalı kaynak NVIDIA sürücüsü + utils. Oyun ve CUDA için önerilir.", "nvidia", self.is_installed("nvidia"))
            self.add_driver_row("NVIDIA Açık Kaynak (nouveau)", "Açık kaynak sürücü, varsayılan olarak kurulu.", "xf86-video-nouveau", self.is_installed("xf86-video-nouveau"))
        if "amd" in lower or "radeon" in lower:
            self.add_driver_row("AMD GPU (amdgpu)", "Modern AMD kartlar için.", "xf86-video-amdgpu", self.is_installed("xf86-video-amdgpu"))
            self.add_driver_row("Vulkan Radeon", "Vulkan desteği.", "vulkan-radeon", self.is_installed("vulkan-radeon"))
        if "intel" in lower:
            self.add_driver_row("Intel GPU", "Intel entegre grafik sürücüsü.", "xf86-video-intel", self.is_installed("xf86-video-intel"))
            self.add_driver_row("Intel Vulkan", "Vulkan Intel.", "vulkan-intel", self.is_installed("vulkan-intel"))
        # Network
        try:
            lsusb = subprocess.check_output(["lsusb"], text=True).lower() if subprocess.run(["which","lsusb"], stdout=subprocess.DEVNULL).returncode==0 else ""
        except:
            lsusb=""
        self.add_driver_row("Mesa 3D", "Açık kaynak 3D hızlandırma.", "mesa", self.is_installed("mesa"))
        self.add_driver_row("Bluetooth", "Bluetooth yığını.", "bluez", self.is_installed("bluez"))
        self.add_driver_row("Yazıcı (CUPS)", "Yazıcı desteği.", "cups", self.is_installed("cups"))
        # VirtualBox guest
        virt = ""
        try:
            virt = subprocess.check_output(["systemd-detect-virt"], text=True).strip().lower()
        except: pass
        if "virtualbox" in virt or "vmware" in virt or "qemu" in virt:
            self.add_driver_row("VirtualBox Guest Utils", "Sanal makine misafir eklentileri.", "virtualbox-guest-utils", self.is_installed("virtualbox-guest-utils"))
        self.show_all()

    def on_install(self, btn, pkg):
        # pkexec ile pacman
        subprocess.Popen(["pkexec","bash","-c",f"pacman -S --noconfirm {pkg}; echo 'Bitti, Enter'a basın'; read"])
        dlg = Gtk.MessageDialog(transient_for=self, flags=0, message_type=Gtk.MessageType.INFO, buttons=Gtk.ButtonsType.OK, text=f"{pkg} kurulumu başlatıldı")
        dlg.format_secondary_text("Terminalde ilerlemeyi takip edin. Bitince Yeniden Tara yapın.")
        dlg.run(); dlg.destroy()

w = HirokiDriverManager()
w.show_all()
Gtk.main()
