    "kde": {"name": "KDE Plasma", "ram": 4096, "desc": "Plasma masaüstü (ISO'da önceden indirildi)",
            "packages": ("plasma-meta", "konsole", "dolphin", "kate", "ark", "sddm"), "dm": "sddm"},
    "lxqt": {"name": "LXQt", "ram": 1024, "desc": "Hafif Qt masaüstü (hızlı kurulum)",
             "packages": ("lxqt", "sddm", "xorg-server", "qt5-base", "qt5-svg"), "dm": "sddm"},
}
