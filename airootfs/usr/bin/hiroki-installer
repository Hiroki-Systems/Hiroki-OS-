LINUX_TYPE = "0fc63daf-8483-4772-8e79-3d69d8477de4"
ROOT_TYPES = {LINUX_TYPE, "4f68bce3-e8cd-4db1-96e7-fbcaf984b709"}
FORBIDDEN_FS = {"crypto_LUKS", "LVM2_member", "linux_raid_member", "zfs_member", "bcache", "BitLocker"}
MODES = {
    "wipe": "Diski tamamen sil ve kur",
    "partition": "Biçimlendirilmiş bölüme kur (ext4)",
}
