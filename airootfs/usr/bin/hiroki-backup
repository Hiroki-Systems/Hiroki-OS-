# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Hiroki Backup")
    app.setOrganizationName("HirokiOS")

    app.setStyleSheet(get_stylesheet())

    window = HirokiBackupWindow()
    window.show()

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
