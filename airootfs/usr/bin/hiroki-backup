    # ---- Settings persistence ----
    def _load_settings(self):
        dest = self.settings.value("dest_dir", DEFAULT_BACKUP_DIR)
        self.dest_entry.setText(dest)
        self.restore_path_label.setText(f"Hedef klasor: {dest}")
        checked = self.settings.value("checked_dirs", ["/home", "/etc"])
        for path, cb in self.checkboxes.items():
            cb.setChecked(path in checked)

    def _save_settings(self):
        self.settings.setValue("dest_dir", self.dest_entry.text())
        checked = [p for p, cb in self.checkboxes.items() if cb.isChecked()]
        self.settings.setValue("checked_dirs", checked)

    # ---- Helpers ----
    def _get_selected_sources(self):
        return [p for p, cb in self.checkboxes.items() if cb.isChecked()]

    def _get_dest_dir(self):
        return self.dest_entry.text().strip()

    def _append_log(self, log_widget, message):
        timestamp = datetime.datetime.now().strftime("%H:%M:%S")
        log_widget.append(f"[{timestamp}] {message}")
        log_widget.moveCursor(QTextCursor.MoveOperation.End)

    def _format_size(self, size_bytes):
        if size_bytes >= 1073741824:
            return f"{size_bytes / 1073741824:.2f} GB"
        elif size_bytes >= 1048576:
            return f"{size_bytes / 1048576:.2f} MB"
        elif size_bytes >= 1024:
            return f"{size_bytes / 1024:.2f} KB"
        return f"{size_bytes} bayt"

    # ---- Backup operations ----
    def _browse_dest(self):
        directory = QFileDialog.getExistingDirectory(
            self, "Yedekleme Klasoru Sec", self._get_dest_dir()
        )
        if directory:
            self.dest_entry.setText(directory)
            self.restore_path_label.setText(f"Hedef klasor: {directory}")
            self._save_settings()
            self._refresh_backups()

    def _estimate_size(self):
        sources = self._get_selected_sources()
        if not sources:
            self.size_label.setText("Lutfen en az bir dizin secin.")
            return

        existing = [s for s in sources if os.path.exists(s)]
        if not existing:
            self.size_label.setText("Secilen hicbir dizin mevcut degil.")
            return

        self.size_label.setText("Hesaplaniyor...")
        QApplication.processEvents()

        total = 0
        for src in existing:
            try:
                result = subprocess.run(
                    ["du", "-sb", src],
                    capture_output=True, text=True, timeout=30
                )
                if result.returncode == 0:
                    total += int(result.stdout.split()[0])
            except Exception:
                pass

        self.size_label.setText(
            f"Tahmini boyut: {self._format_size(total)} "
            f"({len(existing)} dizin secili)"
        )

    def _start_backup(self):
        sources = self._get_selected_sources()
        if not sources:
            QMessageBox.warning(
                self, "Uyari",
                "Lutfen yedeklenecek en az bir dizin secin!"
            )
            return

        dest = self._get_dest_dir()
        if not dest:
            QMessageBox.warning(
                self, "Uyari",
                "Lutfen bir hedef klasor secin!"
            )
            return

        self._save_settings()

        self.backup_btn.setEnabled(False)
        self.backup_btn.setText("Yedekleniyor...")
        self.backup_progress.setValue(0)
        self.backup_log.clear()

        self.backup_worker = BackupWorker(sources, dest)
        self.backup_worker.progress.connect(self._on_backup_progress)
        self.backup_worker.log.connect(
            lambda msg: self._append_log(self.backup_log, msg)
        )
        self.backup_worker.finished_ok.connect(self._on_backup_done)
        self.backup_worker.error.connect(self._on_backup_error)
        self.backup_worker.start()

    def _on_backup_progress(self, value):
        self.backup_progress.setValue(value)

    def _on_backup_done(self, path, size):
        self.backup_btn.setEnabled(True)
        self.backup_btn.setText("Yedekle")
        self.backup_progress.setValue(100)
        self._append_log(
            self.backup_log,
            f"Basarili! Dosya: {os.path.basename(path)} ({self._format_size(size)})"
        )
        self.status_label.setText("Son islem: Yedekleme basarili tamamlandi.")
        QMessageBox.information(
            self, "Yedekleme Tamamlandi",
            f"Yedekleme basariyla olusturuldu.\n\n"
            f"Dosya: {os.path.basename(path)}\n"
            f"Boyut: {self._format_size(size)}\n"
            f"Konum: {path}"
        )
        self._refresh_backups()

    def _on_backup_error(self, msg):
        self.backup_btn.setEnabled(True)
        self.backup_btn.setText("Yedekle")
        self.backup_progress.setValue(0)
        self._append_log(self.backup_log, f"HATA: {msg}")
        self.status_label.setText("Son islem: Yedekleme basarisiz.")
        QMessageBox.critical(self, "Yedekleme Hatasi", msg)

    # ---- Restore operations ----
    def _refresh_backups(self):
        self.backup_list.clear()
        dest = self._get_dest_dir()
        self.restore_path_label.setText(f"Hedef klasor: {dest}")

        if not os.path.isdir(dest):
            self.backup_list.addItem("(Klasor mevcut degil)")
            return

        try:
            files = sorted(
                [
                    f for f in os.listdir(dest)
                    if f.startswith("hiroki-backup-") and f.endswith(".tar.zst")
                ],
                reverse=True,
            )
        except PermissionError:
            self.backup_list.addItem("(Erişim izni yok)")
            return

        if not files:
            self.backup_list.addItem("(Yedek bulunamadi)")
            return

        for f in files:
            full_path = os.path.join(dest, f)
            try:
                size = os.path.getsize(full_path)
                size_str = self._format_size(size)
                mtime = datetime.datetime.fromtimestamp(
                    os.path.getmtime(full_path)
                )
                date_str = mtime.strftime("%d.%m.%Y %H:%M")
                item_text = f"{f}  |  {size_str}  |  {date_str}"
            except OSError:
                item_text = f

            item = QListWidgetItem(item_text)
            item.setData(Qt.ItemDataRole.UserRole, full_path)
            self.backup_list.addItem(item)

    def _on_backup_selected(self, row):
        if row < 0:
            self.restore_btn.setEnabled(False)
            self.preview_text.clear()
            return

        item = self.backup_list.item(row)
        if item is None:
            self.restore_btn.setEnabled(False)
            return

        archive_path = item.data(Qt.ItemDataRole.UserRole)
        if archive_path is None or not os.path.isfile(archive_path):
            self.restore_btn.setEnabled(False)
            return

        self.restore_btn.setEnabled(True)
        self.preview_text.setPlainText("Yukleniyor...")

        if self.details_worker and self.details_worker.isRunning():
            self.details_worker.terminate()

        self.details_worker = DetailsWorker(archive_path)
        self.details_worker.finished.connect(self._on_details_loaded)
        self.details_worker.error.connect(
            lambda msg: self.preview_text.setPlainText(f"Hata: {msg}")
        )
        self.details_worker.start()

    def _on_details_loaded(self, items):
        display = "\n".join(items[:200])
        if len(items) > 200:
            display += f"\n\n... ve {len(items) - 200} dosya daha"
        self.preview_text.setPlainText(display)

    def _open_backup_folder(self):
        dest = self._get_dest_dir()
        if os.path.isdir(dest):
            subprocess.Popen(["xdg-open", dest])
        else:
            QMessageBox.information(
                self, "Bilgi",
                f"Klasor mevcut degil:\n{dest}"
            )

    def _start_restore(self):
        item = self.backup_list.currentItem()
        if item is None:
            return

        archive_path = item.data(Qt.ItemDataRole.UserRole)
        if not archive_path or not os.path.isfile(archive_path):
            QMessageBox.warning(self, "Uyari", "Secilen yedek dosyasi bulunamadi.")
            return

        reply = QMessageBox.warning(
            self,
            "Geri Yukleme Onayi",
            f"Su yedek dosyasi geri yuklenecek:\n\n"
            f"{os.path.basename(archive_path)}\n\n"
            f"Bu islem mevcut dosyalarin uzerine yazabilir!\n"
            f"Devam etmek istediginize emin misiniz?",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
            QMessageBox.StandardButton.No,
        )

        if reply != QMessageBox.StandardButton.Yes:
            return

        self.restore_btn.setEnabled(False)
        self.restore_btn.setText("Geri yukleniyor...")
        self.restore_progress.setValue(0)
        self.restore_log.clear()

        self.restore_worker = RestoreWorker(archive_path)
        self.restore_worker.progress.connect(self._on_restore_progress)
        self.restore_worker.log.connect(
            lambda msg: self._append_log(self.restore_log, msg)
        )
        self.restore_worker.finished_ok.connect(self._on_restore_done)
        self.restore_worker.error.connect(self._on_restore_error)
        self.restore_worker.start()

    def _on_restore_progress(self, value):
        self.restore_progress.setValue(value)

    def _on_restore_done(self, path):
        self.restore_btn.setEnabled(True)
        self.restore_btn.setText("Geri Yukle")
        self.restore_progress.setValue(100)
        self._append_log(
            self.restore_log,
            f"Basarili! Geri yukleme tamamlandi: {os.path.basename(path)}"
        )
        self.status_label.setText("Son islem: Geri yukleme basarili tamamlandi.")
        QMessageBox.information(
            self, "Geri Yukleme Tamamlandi",
            "Geri yukleme basariyla tamamlandi!\n"
            "Bazi degisikliklerin etkili olmasi icin\n"
            "sistemi yeniden baslatmaniz onerilir."
        )

    def _on_restore_error(self, msg):
        self.restore_btn.setEnabled(True)
        self.restore_btn.setText("Geri Yukle")
        self.restore_progress.setValue(0)
        self._append_log(self.restore_log, f"HATA: {msg}")
        self.status_label.setText("Son islem: Geri yukleme basarisiz.")
        QMessageBox.critical(self, "Geri Yukleme Hatasi", msg)

    def closeEvent(self, event):
        if self.backup_worker and self.backup_worker.isRunning():
            reply = QMessageBox.question(
                self,
                "Yedekleme Devam Ediyor",
                "Yedekleme islemi devam ediyor. Iptal etmek ve cikmak istiyor musunuz?",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
                QMessageBox.StandardButton.No,
            )
            if reply == QMessageBox.StandardButton.Yes:
                self.backup_worker.cancel()
                self.backup_worker.wait(3000)
                event.accept()
            else:
                event.ignore()
        else:
            event.accept()


