BG_INPUT = "#2a2a2a"
TEXT_PRIMARY = "#e0e0e0"
TEXT_SECONDARY = "#999999"
BORDER_COLOR = "#333333"
DANGER_RED = "#e74c3c"
SUCCESS_GREEN = "#27ae60"
WARNING_ORANGE = "#f39c12"
DEFAULT_BACKUP_DIR = os.path.expanduser("~/Backups")
AVAILABLE_DIRS = [
    ("/home", "Kullanici dizini"),
    ("/etc", "Sistem yapilandirmasi"),
    ("/boot", "Boot dosyalari"),
    ("/var", "Degisken veriler"),
]


# ---------------------------------------------------------------------------
# Backup Worker Thread
# ---------------------------------------------------------------------------
class BackupWorker(QThread):
    progress = pyqtSignal(int)
    log = pyqtSignal(str)
    finished_ok = pyqtSignal(str, int)
    error = pyqtSignal(str)

    def __init__(self, sources, dest_dir, parent=None):
        super().__init__(parent)
        self.sources = sources
        self.dest_dir = dest_dir
        self._cancelled = False

    def cancel(self):
        self._cancelled = True

    def run(self):
        timestamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
        filename = f"hiroki-backup-{timestamp}.tar.zst"
        archive_path = os.path.join(self.dest_dir, filename)

        existing = [s for s in self.sources if os.path.exists(s)]
        if not existing:
            self.error.emit("Secilen hicbir dizin mevcut degil!")
            return

        total_size = 0
        for src in existing:
            try:
                result = subprocess.run(
                    ["du", "-sb", src],
                    capture_output=True, text=True, timeout=30
                )
                if result.returncode == 0:
                    total_size += int(result.stdout.split()[0])
            except Exception:
                pass

        if total_size > 0:
            if total_size >= 1073741824:
                size_str = f"{total_size / 1073741824:.2f} GB"
            elif total_size >= 1048576:
                size_str = f"{total_size / 1048576:.2f} MB"
            else:
                size_str = f"{total_size / 1024:.2f} KB"
            self.log.emit(f"Tahmini yedekleme boyutu: {size_str}")

        os.makedirs(self.dest_dir, exist_ok=True)

        self.log.emit(f"Yedekleme baslatiliyor: {filename}")
        for i, src in enumerate(existing):
            self.log.emit(f"  -> {src} ekleniyor...")

        try:
            cmd = [
                "tar",
                "--use-compress-program=zstd",
                "-cf", archive_path,
            ]
            for src in existing:
                cmd.append(src)

            self.log.emit(f"Komut: {' '.join(cmd)}")

            process = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )

            while process.poll() is None:
                if self._cancelled:
                    process.terminate()
                    process.wait()
                    self.error.emit("Yedekleme iptal edildi.")
                    return
                self.progress.emit(50)
                process.wait(timeout=1)

            if process.returncode != 0:
                stderr = process.stderr.read().decode("utf-8", errors="replace")
                self.error.emit(f"tar hatasi: {stderr.strip()}")
                return

            self.progress.emit(100)

            archive_size = os.path.getsize(archive_path)
            if archive_size >= 1073741824:
                final_size = f"{archive_size / 1073741824:.2f} GB"
            elif archive_size >= 1048576:
                final_size = f"{archive_size / 1048576:.2f} MB"
            else:
                final_size = f"{archive_size / 1024:.2f} KB"

            self.finished_ok.emit(archive_path, archive_size)

        except FileNotFoundError:
            self.error.emit(
                "tar veya zstd bulunamadi! Lutfen sisteme kurun:\n"
                "  pacman -S tar zstd"
            )
        except Exception as e:
            self.error.emit(f"Beklenmeyen hata: {str(e)}")


# ---------------------------------------------------------------------------
# Restore Worker Thread
# ---------------------------------------------------------------------------
class RestoreWorker(QThread):
    progress = pyqtSignal(int)
    log = pyqtSignal(str)
    finished_ok = pyqtSignal(str)
    error = pyqtSignal(str)

    def __init__(self, archive_path, parent=None):
        super().__init__(parent)
        self.archive_path = archive_path
        self._cancelled = False

    def cancel(self):
        self._cancelled = True

    def run(self):
        self.log.emit(f"Geri yukleme baslatiliyor: {os.path.basename(self.archive_path)}")

        try:
            cmd = [
                "tar",
                "--use-compress-program=zstd",
                "-tf", self.archive_path,
            ]
            result = subprocess.run(
                cmd, capture_output=True, text=True, timeout=30
            )
            if result.returncode != 0:
                self.error.emit("Arsiv icerigi okunamadi.")
                return

            total_items = len(result.stdout.strip().split("\n"))
            self.log.emit(f"Arsiv icerigi: {total_items} dosya/dizin")

            self.progress.emit(10)

            cmd = [
                "tar",
                "--use-compress-program=zstd",
                "-xf", self.archive_path,
                "-C", "/",
            ]

            self.progress.emit(30)

            process = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )

            while process.poll() is None:
                if self._cancelled:
                    process.terminate()
                    process.wait()
                    self.error.emit("Geri yukleme iptal edildi.")
                    return
                self.progress.emit(60)
                process.wait(timeout=1)

            if process.returncode != 0:
                stderr = process.stderr.read().decode("utf-8", errors="replace")
                self.error.emit(f"Geri yukleme hatasi: {stderr.strip()}")
                return

            self.progress.emit(100)
            self.finished_ok.emit(self.archive_path)

        except FileNotFoundError:
            self.error.emit(
                "tar veya zstd bulunamadi! Lutfen sisteme kurun:\n"
                "  pacman -S tar zstd"
            )
        except Exception as e:
            self.error.emit(f"Beklenmeyen hata: {str(e)}")


# ---------------------------------------------------------------------------
# Backup Details Worker (reads archive contents)
# ---------------------------------------------------------------------------
class DetailsWorker(QThread):
    finished = pyqtSignal(list)
    error = pyqtSignal(str)

    def __init__(self, archive_path, parent=None):
        super().__init__(parent)
        self.archive_path = archive_path

    def run(self):
        try:
            cmd = [
                "tar",
                "--use-compress-program=zstd",
                "-tf", self.archive_path,
            ]
            result = subprocess.run(
                cmd, capture_output=True, text=True, timeout=60
            )
            if result.returncode != 0:
                self.error.emit("Arsiv icerigi okunamadi.")
                return

            items = result.stdout.strip().split("\n")
            self.finished.emit(items)
        except FileNotFoundError:
            self.error.emit("tar veya zstd bulunamadi!")
        except Exception as e:
            self.error.emit(f"Hata: {str(e)}")


