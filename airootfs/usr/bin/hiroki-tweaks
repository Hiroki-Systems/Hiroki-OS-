        layout.addWidget(title)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.Shape.NoFrame)
        scroll.setStyleSheet("QScrollArea { background: transparent; border: none; }")
        inner = QWidget()
        inner.setStyleSheet("background: transparent;")
        il = QVBoxLayout(inner)
        il.setSpacing(14)

        g1 = SettingsGroup("Firewall (UFW)")
        f1 = QVBoxLayout()
        ufw_active = systemctl_is_active("ufw")
        ufw_text = "Aktif" if ufw_active else "Pasif"
        ufw_color = "#00d4aa" if ufw_active else "#ff4444"
        self.ufw_status = QLabel(f"UFW Durumu: <span style='color:{ufw_color}'><b>{ufw_text}</b></span>")
        self.ufw_status.setStyleSheet(f"color: {TEXT_COLOR}; font-size: 12px;")
        self.ufw_status.setTextFormat(Qt.TextFormat.RichText)
        f1.addWidget(self.ufw_status)
        self.ufw_enable = make_checkbox("UFW firewall etkin", ufw_active)
        f1.addWidget(self.ufw_enable)
        self.ufw_log = make_checkbox("Firewall log kaydi tut", False)
        f1.addWidget(self.ufw_log)
        r1 = QHBoxLayout()
        r1.addWidget(make_label("Varsayilan politika:"))
        self.ufw_policy = make_combo(["Girisi Reddet", "Girisi Izin Ver", "Cikisi Reddet"])
        r1.addWidget(self.ufw_policy)
        f1.addLayout(r1)
        g1.setLayout(f1)
        il.addWidget(g1)

        g2 = SettingsGroup("Sudo Ayarlari")
        f2 = QVBoxLayout()
        self.sudo_nopass = make_checkbox("Kullanici grubu icin sifresiz sudo (NOPASSWD)", False)
        f2.addWidget(self.sudo_nopass)
        r2 = QHBoxLayout()
        r2.addWidget(make_label("Sudo suresi (dk):"))
        self.sudo_timeout = make_spinbox(1, 60, 5)
        r2.addWidget(self.sudo_timeout)
        f2.addLayout(r2)
        self.sudo_timestamp = make_checkbox("Sudo zaman damgasi koru", True)
        f2.addWidget(self.sudo_timestamp)
        g2.setLayout(f2)
        il.addWidget(g2)

        g3 = SettingsGroup("Oturum Guvenligi")
        f3 = QVBoxLayout()
        self.autologin = make_checkbox("Oturum acma (auto-login) aktif", False)
        f3.addWidget(self.autologin)
        r3 = QHBoxLayout()
        r3.addWidget(make_label("Oturum acacak kullanici:"))
        self.autologin_user = make_line_edit(os.getenv("USER", ""))
        r3.addWidget(self.autologin_user)
        f3.addLayout(r3)
        self.lock_screen = make_checkbox("Ekran kilitleme aktif", True)
        f3.addWidget(self.lock_screen)
        self.screen_blank_time = make_spinbox(1, 120, 10)
        r4 = QHBoxLayout()
        r4.addWidget(make_label("Ekran karartma suresi (dk):"))
        r4.addWidget(self.screen_blank_time)
        f3.addLayout(r4)
        g3.setLayout(f3)
        il.addWidget(g3)

        il.addStretch()
        scroll.setWidget(inner)
        layout.addWidget(scroll, 1)

        btn_row = QHBoxLayout()
        btn_row.addStretch()
        btn_row.addWidget(make_button("Durum Kontrol", False))
        btn_row.addWidget(make_button("Kaydet", True))
        layout.addLayout(btn_row)


class PageSistem(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        layout = QVBoxLayout(self)
        layout.setSpacing(12)
        layout.setContentsMargins(20, 20, 20, 20)

        title = QLabel("Sistem Ayarlari")
        title.setStyleSheet(f"color: {ACCENT}; font-size: 18px; font-weight: bold; padding-bottom: 4px;")
        layout.addWidget(title)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.Shape.NoFrame)
        scroll.setStyleSheet("QScrollArea { background: transparent; border: none; }")
        inner = QWidget()
        inner.setStyleSheet("background: transparent;")
        il = QVBoxLayout(inner)
        il.setSpacing(14)

        g1 = SettingsGroup("ZRAM (Sikistirilmis RAM)")
        f1 = QVBoxLayout()
        zram_active = systemctl_is_active("zramswap")
        zram_text = "Aktif" if zram_active else "Pasif"
        zram_color = "#00d4aa" if zram_active else "#ff4444"
        self.zram_status = QLabel(f"ZRAM Durumu: <span style='color:{zram_color}'><b>{zram_text}</b></span>")
        self.zram_status.setStyleSheet(f"color: {TEXT_COLOR}; font-size: 12px;")
        self.zram_status.setTextFormat(Qt.TextFormat.RichText)
        f1.addWidget(self.zram_status)
        self.zram_enable = make_checkbox("ZRAM etkinlestir", zram_active)
        f1.addWidget(self.zram_enable)
        r1 = QHBoxLayout()
        r1.addWidget(make_label("ZRAM boyutu (MB):"))
        self.zram_size = make_spinbox(256, 32768, 4096)
        r1.addWidget(self.zram_size)
        f1.addLayout(r1)
        g1.setLayout(f1)
        il.addWidget(g1)

        g2 = SettingsGroup("Swap")
        f2 = QVBoxLayout()
        swap_info = run_cmd("swapon --show --bytes | tail -1 | awk '{print $3}'")
        swap_mb = int(int(swap_info) / 1024 / 1024) if swap_info.isdigit() and int(swap_info) > 0 else 0
        self.swap_info_label = make_label(f"Mevcut swap: {swap_mb} MB")
        f2.addWidget(self.swap_info_label)
        r2 = QHBoxLayout()
        r2.addWidget(make_label("Swap onceligi (swappiness):"))
        self.swappiness = make_spinbox(0, 200, int(read_sysctl("vm.swappiness")) if read_sysctl("vm.swappiness").isdigit() else 60)
        r2.addWidget(self.swappiness)
        f2.addLayout(r2)
        r3 = QHBoxLayout()
        r3.addWidget(make_label("VFS cache onceligi:"))
        self.vfs_cache = make_spinbox(0, 100, int(read_sysctl("vm.vfs_cache_pressure")) if read_sysctl("vm.vfs_cache_pressure").isdigit() else 100)
        r3.addWidget(self.vfs_cache)
        f2.addLayout(r3)
        g2.setLayout(f2)
        il.addWidget(g2)

        g3 = SettingsGroup("CPU Governor")
        f3 = QVBoxLayout()
        current_gov = run_cmd("cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null") or "Bilinmiyor"
        r4 = QHBoxLayout()
        r4.addWidget(make_label("CPU governor:"))
        self.governor_combo = make_combo(["performance", "powersave", "ondemand", "schedutil", "conservative"], current_gov)
        r4.addWidget(self.governor_combo)
        f3.addLayout(r4)
        self.turbo_check = make_checkbox("Turbo boost aktif", True)
        f3.addWidget(self.turbo_check)
        g3.setLayout(f3)
        il.addWidget(g3)

        g4 = SettingsGroup("Hostname")
        f4 = QVBoxLayout()
        current_hostname = run_cmd("hostname")
        self.hostname_display = make_label(f"Mevcut hostname: {current_hostname}")
        f4.addWidget(self.hostname_display)
        r5 = QHBoxLayout()
        r5.addWidget(make_label("Yeni hostname:"))
        self.hostname_new = make_line_edit(current_hostname)
        r5.addWidget(self.hostname_new)
        f4.addLayout(r5)
        g4.setLayout(f4)
        il.addWidget(g4)

        g5 = SettingsGroup("GRUB Ayarlari")
        f5 = QVBoxLayout()
        grub_path = "/etc/default/grub"
        self.grub_path = grub_path
        self.grub_content = read_file(grub_path)
        if self.grub_content:
            grub_lines = self.grub_content.splitlines()
            timeout_val = "10"
            for line in grub_lines:
                if line.startswith("GRUB_TIMEOUT="):
                    timeout_val = line.split("=")[1].strip().strip('"')
                    break
        else:
            timeout_val = "10"
        r6 = QHBoxLayout()
        r6.addWidget(make_label("GRUB zaman asimi (sn):"))
        self.grub_timeout = make_spinbox(0, 60, int(timeout_val) if timeout_val.isdigit() else 10)
        r6.addWidget(self.grub_timeout)
        f5.addLayout(r6)
        self.grub_splash = make_checkbox("GRUB splash ekranini aktif et", True)
        f5.addWidget(self.grub_splash)
        self.grub_verbose = make_checkbox("Ayrintili (verbose) mod", False)
        f5.addWidget(self.grub_verbose)
        g5.setLayout(f5)
        il.addWidget(g5)

        il.addStretch()
        scroll.setWidget(inner)
        layout.addWidget(scroll, 1)

        btn_row = QHBoxLayout()
        btn_row.addStretch()
        btn_row.addWidget(make_button("Bilgi Yenile", False))
        btn_row.addWidget(make_button("Kaydet", True))
        layout.addLayout(btn_row)


class HirokiTweaks(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Hiroki OS - Sistem Ayarlari")
        self.setMinimumSize(750, 550)
        self.resize(860, 620)
        self._apply_palette()
        self._build_ui()

    def _apply_palette(self):
        palette = QPalette()
        palette.setColor(QPalette.ColorRole.Window, QColor(BG_DARK))
        palette.setColor(QPalette.ColorRole.WindowText, QColor(TEXT_COLOR))
        palette.setColor(QPalette.ColorRole.Base, QColor(BG_INPUT))
        palette.setColor(QPalette.ColorRole.AlternateBase, QColor(BG_DARK))
        palette.setColor(QPalette.ColorRole.ToolTipBase, QColor(BG_CARD))
        palette.setColor(QPalette.ColorRole.ToolTipText, QColor(TEXT_COLOR))
        palette.setColor(QPalette.ColorRole.Text, QColor(TEXT_COLOR))
        palette.setColor(QPalette.ColorRole.Button, QColor(BG_CARD))
        palette.setColor(QPalette.ColorRole.ButtonText, QColor(TEXT_COLOR))
        palette.setColor(QPalette.ColorRole.Highlight, QColor(ACCENT))
        palette.setColor(QPalette.ColorRole.HighlightedText, QColor("#ffffff"))
        QApplication.instance().setPalette(palette)

    def _build_ui(self):
        central = QWidget()
        self.setCentralWidget(central)
        central.setStyleSheet(f"background-color: {BG_DARK};")

        main_layout = QHBoxLayout(central)
        main_layout.setContentsMargins(0, 0, 0, 0)
        main_layout.setSpacing(0)

        sidebar = QFrame()
        sidebar.setFixedWidth(210)
        sidebar.setStyleSheet(f"""
            QFrame {{
                background-color: #0d0d0d;
                border-right: 1px solid {BORDER_COLOR};
            }}
        """)
        sb_layout = QVBoxLayout(sidebar)
        sb_layout.setContentsMargins(12, 16, 12, 16)
        sb_layout.setSpacing(4)

        logo_label = QLabel("Hiroki OS")
        logo_label.setStyleSheet(f"""
            color: {ACCENT};
            font-size: 20px;
            font-weight: bold;
            padding: 8px 4px;
            padding-bottom: 4px;
        """)
        sb_layout.addWidget(logo_label)

        subtitle = QLabel("Sistem Ayarlari")
        subtitle.setStyleSheet(f"color: {TEXT_DIM}; font-size: 11px; padding: 0 4px 12px 4px;")
        sb_layout.addWidget(subtitle)
        sb_layout.addWidget(sep())

        self.categories = [
            ("Genel", "Genel"),
            ("Masaustu", "Masaustu"),
            ("Pencere", "Pencere"),
            ("Ag", "Ag"),
            ("Guvenlik", "Guvenlik"),
            ("Sistem", "Sistem"),
        ]

        self.side_buttons = []
        for text, _ in self.categories:
            btn = SideButton(f"  {text}")
            btn.clicked.connect(lambda checked, b=btn: self._on_category_click(b))
            sb_layout.addWidget(btn)
            self.side_buttons.append(btn)

        sb_layout.addStretch()

        version_lbl = QLabel("v1.0.0")
        version_lbl.setStyleSheet(f"color: {TEXT_DIM}; font-size: 10px; padding: 4px;")
        sb_layout.addWidget(version_lbl)

        main_layout.addWidget(sidebar)

        right_panel = QFrame()
        right_panel.setStyleSheet(f"background-color: {BG_DARK};")
        rp_layout = QVBoxLayout(right_panel)
        rp_layout.setContentsMargins(0, 0, 0, 0)
        rp_layout.setSpacing(0)

        header = QFrame()
        header.setFixedHeight(52)
        header.setStyleSheet(f"""
            QFrame {{
                background-color: #0d0d0d;
                border-bottom: 1px solid {BORDER_COLOR};
            }}
        """)
        h_layout = QHBoxLayout(header)
        h_layout.setContentsMargins(20, 0, 20, 0)
        self.header_title = QLabel("Sistem Ayarlari")
        self.header_title.setStyleSheet(f"color: {ACCENT}; font-size: 16px; font-weight: bold;")
        h_layout.addWidget(self.header_title)
        h_layout.addStretch()
        rp_layout.addWidget(header)

        self.stack = QStackedWidget()
        self.stack.setStyleSheet(f"QStackedWidget {{ background-color: {BG_DARK}; }}")

        self.page_genel = PageGenel()
        self.page_masaustu = PageMasaustu()
        self.page_pencere = PagePencere()
        self.page_ag = PageAg()
        self.page_guvenlik = PageGuvenlik()
        self.page_sistem = PageSistem()

        self.stack.addWidget(self.page_genel)
        self.stack.addWidget(self.page_masaustu)
        self.stack.addWidget(self.page_pencere)
        self.stack.addWidget(self.page_ag)
        self.stack.addWidget(self.page_guvenlik)
        self.stack.addWidget(self.page_sistem)

        rp_layout.addWidget(self.stack, 1)
        main_layout.addWidget(right_panel, 1)

        self.side_buttons[0].setChecked(True)
        self._on_category_click(self.side_buttons[0])

    def _on_category_click(self, clicked_btn):
        for i, btn in enumerate(self.side_buttons):
            if btn is clicked_btn:
                btn.setChecked(True)
                self.stack.setCurrentIndex(i)
                self.header_title.setText(self.categories[i][1])
            else:
                btn.setChecked(False)


def main():
    app = QApplication(sys.argv)
    app.setStyle("Fusion")
    app.setStyleSheet(f"""
        * {{
            font-family: "Segoe UI", "Noto Sans", "DejaVu Sans", sans-serif;
            font-size: 12px;
        }}
        QToolTip {{
            background-color: {BG_CARD};
            color: {TEXT_COLOR};
            border: 1px solid {BORDER_COLOR};
            padding: 6px;
            border-radius: 4px;
        }}
        QScrollBar:vertical {{
            background: {BG_DARK};
            width: 10px;
            margin: 0;
        }}
        QScrollBar::handle:vertical {{
            background: #444444;
            min-height: 30px;
            border-radius: 5px;
        }}
        QScrollBar::handle:vertical:hover {{
            background: {ACCENT};
        }}
        QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{
            height: 0;
        }}
        QScrollBar:horizontal {{
            background: {BG_DARK};
            height: 10px;
            margin: 0;
        }}
        QScrollBar::handle:horizontal {{
            background: #444444;
            min-width: 30px;
            border-radius: 5px;
        }}
        QScrollBar::handle:horizontal:hover {{
            background: {ACCENT};
        }}
        QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {{
            width: 0;
        }}
    """)
    window = HirokiTweaks()
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
