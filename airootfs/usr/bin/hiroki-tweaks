ACCENT = "#d34188"
BG_DARK = "#111111"
BG_CARD = "#1a1a1a"
BG_INPUT = "#222222"
TEXT_COLOR = "#e0e0e0"
TEXT_DIM = "#888888"
BORDER_COLOR = "#333333"


def run_cmd(cmd, capture=True):
    try:
        r = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=capture, text=True, timeout=10)
        return r.stdout.strip() if capture else ""
    except Exception:
        return ""


def run_sudo(cmd):
    try:
        subprocess.run(["pkexec", "bash", "-c", cmd], timeout=30)
    except Exception:
        try:
            subprocess.run(["sudo", "bash", "-c", cmd], timeout=30)
        except Exception:
            pass


def read_file(path):
    try:
        with open(path, "r") as f:
            return f.read()
    except Exception:
        return ""


def write_file(path, content):
    run_sudo(f"tee '{path}' > /dev/null <<'HTWEAKS_EOF'\n{content}\nHTWEAKS_EOF")


def read_sysctl(key):
    return run_cmd(f"sysctl -n {key} 2>/dev/null")


def write_sysctl(key, val):
    run_sudo(f"sysctl -w {key}={val}")
    run_sudo(f"grep -q '^{key}' /etc/sysctl.d/99-hiroki.conf 2>/dev/null && sed -i 's|^{key}.*|{key} = {val}|' /etc/sysctl.d/99-hiroki.conf || echo '{key} = {val}' | sudo tee -a /etc/sysctl.d/99-hiroki.conf > /dev/null")


def kde_write(group, key, value, kde5=True, kde6=True):
    if kde5 and shutil.which("kwriteconfig5"):
        run_cmd(f"kwriteconfig5 --file plasmarc --group Theme --key name '{value}'")
        run_cmd(f"kwriteconfig5 --group '{group}' --key '{key}' '{value}'")
    if kde6 and shutil.which("kwriteconfig6"):
        run_cmd(f"kwriteconfig6 --group '{group}' --key '{key}' '{value}'")


def systemctl_is_active(service):
    return run_cmd(f"systemctl is-active {service}") == "active"


def systemctl_enable(service, enable):
    on = "enable" if enable else "disable"
    run_sudo(f"systemctl {on} {service}")


def systemctl_start_stop(service, start):
    action = "start" if start else "stop"
    run_sudo(f"systemctl {action} {service}")


class StyledWidget(QFrame):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setStyleSheet(f"""
            QFrame {{
                background-color: {BG_CARD};
                border: 1px solid {BORDER_COLOR};
                border-radius: 8px;
                padding: 12px;
            }}
        """)


class SideButton(QPushButton):
    def __init__(self, text, parent=None):
        super().__init__(text, parent)
        self.setCheckable(True)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setFixedHeight(42)
        self._update_style(False)
        self.toggled.connect(self._update_style)

    def _update_style(self, checked):
        if checked:
            self.setStyleSheet(f"""
                QPushButton {{
                    background-color: {ACCENT};
                    color: #ffffff;
                    border: none;
                    border-radius: 6px;
                    padding: 8px 16px;
                    font-size: 13px;
                    font-weight: bold;
                    text-align: left;
                    padding-left: 14px;
                }}
            """)
        else:
            self.setStyleSheet(f"""
                QPushButton {{
                    background-color: transparent;
                    color: {TEXT_COLOR};
                    border: none;
                    border-radius: 6px;
                    padding: 8px 16px;
                    font-size: 13px;
                    text-align: left;
                    padding-left: 14px;
                }}
                QPushButton:hover {{
                    background-color: #2a2a2a;
                }}
            """)


class SettingsGroup(QGroupBox):
    def __init__(self, title, parent=None):
        super().__init__(title, parent)
        self.setStyleSheet(f"""
            QGroupBox {{
                color: {ACCENT};
                font-size: 13px;
                font-weight: bold;
                border: 1px solid {BORDER_COLOR};
                border-radius: 8px;
                margin-top: 14px;
                padding: 16px 12px 12px 12px;
                background-color: {BG_CARD};
            }}
            QGroupBox::title {{
                subcontrol-origin: margin;
                subcontrol-position: top left;
                left: 14px;
                top: 2px;
                padding: 0 6px;
                background-color: {BG_CARD};
            }}
        """)


def make_combo(items, current=None):
    combo = QComboBox()
    combo.addItems(items)
    combo.setStyleSheet(f"""
        QComboBox {{
            background-color: {BG_INPUT};
            color: {TEXT_COLOR};
            border: 1px solid {BORDER_COLOR};
            border-radius: 4px;
            padding: 6px 10px;
            font-size: 12px;
            min-width: 180px;
        }}
        QComboBox:hover {{ border-color: {ACCENT}; }}
        QComboBox::drop-down {{
            border: none;
            width: 24px;
        }}
        QComboBox QAbstractItemView {{
            background-color: {BG_INPUT};
            color: {TEXT_COLOR};
            border: 1px solid {BORDER_COLOR};
            selection-background-color: {ACCENT};
        }}
    """)
    if current and current in items:
        combo.setCurrentText(current)
    return combo


def make_line_edit(placeholder=""):
    le = QLineEdit()
    le.setPlaceholderText(placeholder)
    le.setStyleSheet(f"""
        QLineEdit {{
            background-color: {BG_INPUT};
            color: {TEXT_COLOR};
            border: 1px solid {BORDER_COLOR};
            border-radius: 4px;
            padding: 6px 10px;
            font-size: 12px;
            min-width: 220px;
        }}
        QLineEdit:focus {{ border-color: {ACCENT}; }}
    """)
    return le


def make_checkbox(text, checked=False):
    cb = QCheckBox(text)
    cb.setChecked(checked)
    cb.setStyleSheet(f"""
        QCheckBox {{
            color: {TEXT_COLOR};
            font-size: 12px;
            spacing: 8px;
        }}
        QCheckBox::indicator {{
            width: 16px;
            height: 16px;
            border: 2px solid {BORDER_COLOR};
            border-radius: 3px;
            background-color: {BG_INPUT};
        }}
        QCheckBox::indicator:checked {{
            background-color: {ACCENT};
            border-color: {ACCENT};
        }}
    """)
    return cb


def make_spinbox(min_val=0, max_val=10000, val=0):
    sb = QSpinBox()
    sb.setRange(min_val, max_val)
    sb.setValue(val)
    sb.setStyleSheet(f"""
        QSpinBox {{
            background-color: {BG_INPUT};
            color: {TEXT_COLOR};
            border: 1px solid {BORDER_COLOR};
            border-radius: 4px;
            padding: 6px 10px;
            font-size: 12px;
            min-width: 100px;
        }}
        QSpinBox:focus {{ border-color: {ACCENT}; }}
    """)
    return sb


def make_button(text, primary=True):
    btn = QPushButton(text)
    btn.setCursor(Qt.CursorShape.PointingHandCursor)
    btn.setFixedHeight(34)
    if primary:
        btn.setStyleSheet(f"""
            QPushButton {{
                background-color: {ACCENT};
                color: #ffffff;
                border: none;
                border-radius: 5px;
                padding: 6px 20px;
                font-size: 12px;
                font-weight: bold;
            }}
            QPushButton:hover {{ background-color: #e0509a; }}
            QPushButton:pressed {{ background-color: #c03078; }}
        """)
    else:
        btn.setStyleSheet(f"""
            QPushButton {{
                background-color: #2a2a2a;
                color: {TEXT_COLOR};
                border: 1px solid {BORDER_COLOR};
                border-radius: 5px;
                padding: 6px 20px;
                font-size: 12px;
            }}
            QPushButton:hover {{ background-color: #333333; border-color: {ACCENT}; }}
        """)
    return btn


def make_info_label(text):
    lbl = QLabel(text)
    lbl.setWordWrap(True)
    lbl.setStyleSheet(f"color: {TEXT_DIM}; font-size: 11px; padding: 2px;")
    return lbl


def make_label(text, bold=False):
    lbl = QLabel(text)
    lbl.setStyleSheet(f"color: {TEXT_COLOR}; font-size: 12px; {'font-weight: bold;' if bold else ''} padding: 2px;")
    return lbl


def make_slider(min_val=0, max_val=100, val=50):
    sl = QSlider(Qt.Orientation.Horizontal)
    sl.setRange(min_val, max_val)
    sl.setValue(val)
    sl.setStyleSheet(f"""
        QSlider::groove:horizontal {{
            height: 6px;
            background: {BG_INPUT};
            border-radius: 3px;
        }}
        QSlider::handle:horizontal {{
            background: {ACCENT};
            width: 16px;
            height: 16px;
            margin: -5px 0;
            border-radius: 8px;
        }}
        QSlider::handle:horizontal:hover {{ background: #e0509a; }}
    """)
    return sl


def sep():
    line = QFrame()
    line.setFrameShape(QFrame.Shape.HLine)
    line.setStyleSheet(f"background-color: {BORDER_COLOR}; max-height: 1px;")
    return line


class PageGenel(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        layout = QVBoxLayout(self)
        layout.setSpacing(12)
        layout.setContentsMargins(20, 20, 20, 20)

        title = QLabel("Genel Ayarlar")
        title.setStyleSheet(f"color: {ACCENT}; font-size: 18px; font-weight: bold; padding-bottom: 4px;")
        layout.addWidget(title)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.Shape.NoFrame)
        scroll.setStyleSheet("QScrollArea { background: transparent; border: none; }")
        inner = QWidget()
        inner.setStyleSheet("background: transparent;")
        il = QVBoxLayout(inner)
        il.setSpacing(14)

        g1 = SettingsGroup("Sistem Adi (Hostname)")
        f1 = QHBoxLayout()
        self.hostname_input = make_line_edit()
        current_host = run_cmd("hostname")
        self.hostname_input.setText(current_host)
        f1.addWidget(make_label("Hostname:"))
        f1.addWidget(self.hostname_input)
        g1.setLayout(f1)
        il.addWidget(g1)

        g2 = SettingsGroup("Varsayilan Uygulama")
        f2 = QVBoxLayout()
        r1 = QHBoxLayout()
        r1.addWidget(make_label("Tarayici:"))
        self.browser_combo = make_combo(["firefox", "chromium", "qutebrowser", "lynx", "surf"])
        r1.addWidget(self.browser_combo)
        f2.addLayout(r1)
        r2 = QHBoxLayout()
        r2.addWidget(make_label("Dosya Yoneticisi:"))
        self.filemgr_combo = make_combo(["dolphin", "thunar", "pcmanfm", "nautilus", "nemo"])
        r2.addWidget(self.filemgr_combo)
        f2.addLayout(r2)
        r3 = QHBoxLayout()
        r3.addWidget(make_label("Metin Duzenleyici:"))
        self.editor_combo = make_combo(["kate", "kwrite", "mousepad", "leafpad", "nano", "vim"])
        r3.addWidget(self.editor_combo)
        f2.addLayout(r3)
        g2.setLayout(f2)
        il.addWidget(g2)

        g3 = SettingsGroup("Oturum Ayarlari")
        f3 = QVBoxLayout()
        self.autostart_check = make_checkbox("Ototum baslangic uygulamalarini etkinlestir", True)
        f3.addWidget(self.autostart_check)
        self.screensaver_check = make_checkbox("Ekran koruyucuyu etkinlestir", False)
        f3.addWidget(self.screensaver_check)
        self.notifications_check = make_checkbox("Sistem bildirimlerini goster", True)
        f3.addWidget(self.notifications_check)
        g3.setLayout(f3)
        il.addWidget(g3)

        il.addStretch()
        scroll.setWidget(inner)
        layout.addWidget(scroll, 1)

        btn_row = QHBoxLayout()
        btn_row.addStretch()
        btn_row.addWidget(make_button("Varlari Sifirla", False))
        btn_row.addWidget(make_button("Kaydet", True))
        layout.addLayout(btn_row)


