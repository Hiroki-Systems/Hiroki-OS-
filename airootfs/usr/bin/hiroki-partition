        self.table = QTableWidget()
        self.table.setColumnCount(6)
        self.table.setHorizontalHeaderLabels(
            ["Bolum Adi", "Boyut", "Tur", "Mount Noktasi", "Dosya Sistemi", "UUID"]
        )
        self.table.horizontalHeader().setSectionResizeMode(QHeaderView.ResizeMode.Stretch)
        self.table.horizontalHeader().setSectionResizeMode(0, QHeaderView.ResizeMode.ResizeToContents)
        self.table.setSelectionBehavior(QAbstractItemView.SelectionBehavior.SelectRows)
        self.table.setSelectionMode(QAbstractItemView.SelectionMode.SingleSelection)
        self.table.setEditTriggers(QAbstractItemView.EditTrigger.NoEditTriggers)
        self.table.setAlternatingRowColors(True)
        self.table.setShowGrid(False)
        self.table.verticalHeader().setVisible(False)
        self.table.setMinimumHeight(180)
        self.table.currentCellChanged.connect(self._on_row_changed)

        table_layout.addWidget(self.table)
        main_layout.addWidget(table_group)

        # Buttons
        btn_layout = QHBoxLayout()
        btn_layout.setSpacing(8)

        self.create_btn = QPushButton("Bolustur")
        self.create_btn.setObjectName("primaryBtn")
        self.create_btn.clicked.connect(self._create_partition)

        self.delete_btn = QPushButton("Sil")
        self.delete_btn.setObjectName("dangerBtn")
        self.delete_btn.clicked.connect(self._delete_partition)

        self.format_btn = QPushButton("Bi Formatting")
        self.format_btn.clicked.connect(self._format_partition)

        self.mount_btn = QPushButton("Bagla")
        self.mount_btn.clicked.connect(self._mount_partition)

        btn_layout.addWidget(self.create_btn)
        btn_layout.addWidget(self.delete_btn)
        btn_layout.addWidget(self.format_btn)
        btn_layout.addWidget(self.mount_btn)
        btn_layout.addStretch()

        main_layout.addLayout(btn_layout)

        # Status bar area
        self.status_label = QLabel("Hazir")
        self.status_label.setStyleSheet(f"color: {TEXT_SECONDARY}; font-size: 12px; padding: 4px;")
        main_layout.addWidget(self.status_label)

        self.setStyleSheet(DARK_STYLE)
        self.refresh_disks()

    def refresh_disks(self):
        self.status_label.setText("Diskler taraniyor...")
        self.disk_combo.blockSignals(True)
        self.disk_combo.clear()
        disks = get_disks()
        self._disks = disks
        for d in disks:
            self.disk_combo.addItem(f"{d['path']}  -  {d['size']}  ({d['model']})", d['name'])
        self.disk_combo.blockSignals(False)
        if self.disk_combo.count() > 0:
            self.disk_combo.setCurrentIndex(0)
            self._on_disk_changed(0)
        else:
            self.status_label.setText("Disk bulunamadi.")
        self._update_btn_states()

    def _on_disk_changed(self, index):
        if index < 0 or index >= len(self._disks):
            return
        disk = self._disks[index]
        self.selected_disk = disk["name"]
        self.disk_size = get_disk_size_bytes(self.selected_disk)
        self.disk_info_label.setText(
            f"Toplam: {disk['size']}  |  Model: {disk['model']}  |  "
            f"Boyut: {bytes_to_human(self.disk_size)}"
        )
        self._load_partitions()

    def _load_partitions(self):
        if not self.selected_disk:
            return
        self.status_label.setText(f"/dev/{self.selected_disk} taraniyor...")
        self.partitions_data = get_partitions(self.selected_disk)

        # Compute free space by subtracting partition sizes from disk size
        used = 0
        for p in self.partitions_data:
            used += parse_size_to_bytes(p.get("size", "0"))
        free = max(0, self.disk_size - used)

        # Add free space entry if meaningful
        display_partitions = list(self.partitions_data)
        if free > 1024 * 1024:  # more than 1MB free
            display_partitions.append({
                "name": "Bos Alan",
                "size": bytes_to_human(free),
                "fstype": "",
                "mountpoint": "",
                "type": "free",
                "parttype": "",
                "uuid": "",
            })

        self.partition_bar.set_partitions(display_partitions, self.disk_size)

        self.table.setRowCount(0)
        mounted = get_mounted_partitions()
        for p in self.partitions_data:
            row = self.table.rowCount()
            self.table.insertRow(row)
            is_mnt = p["name"] in mounted

            name_item = QTableWidgetItem(p["name"])
            if is_mnt:
                name_item.setForeground(QColor("#00cc66"))
            self.table.setItem(row, 0, name_item)
            self.table.setItem(row, 1, QTableWidgetItem(p.get("size", "")))

            ptype = p.get("parttype", "")
            if ptype:
                ptype_display = ptype
            else:
                ptype_display = "normal"
            self.table.setItem(row, 2, QTableWidgetItem(ptype_display))

            mnt_item = QTableWidgetItem(p.get("mountpoint", ""))
            if is_mnt:
                mnt_item.setForeground(QColor("#00cc66"))
            self.table.setItem(row, 3, mnt_item)

            self.table.setItem(row, 4, QTableWidgetItem(p.get("fstype", "")))
            self.table.setItem(row, 5, QTableWidgetItem(p.get("uuid", "")))

        self.status_label.setText(
            f"{len(self.partitions_data)} bol ayrinti bulundu  |  "
            f"Bos alan: {bytes_to_human(free)}"
        )
        self._update_btn_states()

    def _on_row_changed(self, current_row, previous_row):
        self.partition_bar.set_selected(-1)
        if current_row >= 0 and current_row < len(self.partitions_data):
            self.partition_bar.set_selected(current_row)
        self._update_btn_states()

    def _get_selected_partition(self):
        row = self.table.currentRow()
        if row < 0 or row >= len(self.partitions_data):
            return None
        return self.partitions_data[row]

    def _is_running_system_disk(self):
        return self.selected_disk == self.running_disk

    def _update_btn_states(self):
        part = self._get_selected_partition()
        has_sel = part is not None
        self.create_btn.setEnabled(self.selected_disk is not None)
        self.delete_btn.setEnabled(has_sel)
        self.format_btn.setEnabled(has_sel)
        self.mount_btn.setEnabled(has_sel)

    def _show_warning(self, title, message):
        msg = QMessageBox(self)
        msg.setIcon(QMessageBox.Icon.Warning)
        msg.setWindowTitle(title)
        msg.setText(message)
        msg.setStandardButtons(QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
        msg.setDefaultButton(QMessageBox.StandardButton.No)
        for btn in msg.buttons():
            if msg.buttonRole(btn) == QMessageBox.ButtonRole.YesRole:
                btn.setStyleSheet(f"background-color: {ACCENT}; color: white; border: 1px solid {ACCENT}; padding: 6px 16px; border-radius: 4px;")
        msg.setStyleSheet(DARK_STYLE)
        return msg.exec()

    def _show_info(self, title, message):
        msg = QMessageBox(self)
        msg.setIcon(QMessageBox.Icon.Information)
        msg.setWindowTitle(title)
        msg.setText(message)
        msg.setStandardButtons(QMessageBox.StandardButton.Ok)
        msg.setStyleSheet(DARK_STYLE)
        msg.exec()

    def _show_error(self, title, message):
        msg = QMessageBox(self)
        msg.setIcon(QMessageBox.Icon.Critical)
        msg.setWindowTitle(title)
        msg.setText(message)
        msg.setStandardButtons(QMessageBox.StandardButton.Ok)
        msg.setStyleSheet(DARK_STYLE)
        msg.exec()

    def _run_cmd_async(self, cmd, callback):
        """Run a command asynchronously and call callback when done."""
        self.status_label.setText("Komut calistiriliyor...")
        self._worker = WorkerThread(cmd)
        self._worker.finished.connect(lambda rc, out, err: self._on_cmd_finished(rc, out, err, callback))
        self._worker.start()

    def _on_cmd_finished(self, rc, out, err, callback):
        self._worker = None
        callback(rc, out, err)
        self._load_partitions()

    def _create_partition(self):
        if not self.selected_disk:
            return

        if self._is_running_system_disk():
            self._show_error("Hata", "Bu disk calisan sistem diski. Uzerinde bol ayrinti olusturulamaz.")
            return

        # Calculate free space
        used = 0
        for p in self.partitions_data:
            used += parse_size_to_bytes(p.get("size", "0"))
        free = max(0, self.disk_size - used)
        if free < 1024 * 1024:
            self._show_error("Hata", "Diskte yeterli bos alan yok.")
            return

        dialog = CreatePartitionDialog(f"/dev/{self.selected_disk}", bytes_to_human(free), self)
        if dialog.exec() != QDialog.DialogCode.Accepted:
            return

        vals = dialog.get_values()
        if vals["size_mb"] <= 0:
            self._show_error("Hata", "Gecersiz boyut.")
            return

        size_bytes = vals["size_mb"] * 1024 * 1024
        if size_bytes > free:
            self._show_error("Hata", f"Istenen boyut ({bytes_to_human(size_bytes)}) bos alandan buyuk.")
            return

        confirm = self._show_warning(
            "Onay",
            f"/dev/{self.selected_disk} uzerinde {vals['size_mb']} MB boyutunda "
            f"{vals['fs_type']} bol ayrinti olusturulacak.\n\n"
            f"Devam etmek istediginizden emin misiniz?"
        )
        if confirm != QMessageBox.StandardButton.Yes:
            return

        # Use sfdisk to create partition
        # Get partition count to determine next partition number
        part_count = len(self.partitions_data)
        next_num = part_count + 1

        if self.selected_disk.startswith("nvme"):
            part_name = f"{self.selected_disk}p{next_num}"
        else:
            part_name = f"{self.selected_disk}{next_num}"

        # Create partition with sfdisk
        size_sectors = vals["size_mb"] * 1024 * 2  # 512 byte sectors
        cmd = (
            f'echo ",+{size_sectors}s,{vals["fs_type"]}" | '
            f'sfdisk --append --no-reread --force /dev/{self.selected_disk}'
        )

        self._run_cmd_async(cmd, lambda rc, out, err: self._on_create_done(rc, out, err, vals, part_name))

    def _on_create_done(self, rc, out, err, vals, part_name):
        if rc != 0:
            self._show_error("Hata", f"Bolusturme basarisiz:\n{err or out}")
            return

        # Wait for kernel to re-read partition table
        run_cmd(f"partprobe /dev/{self.selected_disk}", timeout=10)

        # Format if needed
        if vals["fs_type"] != "swap" and vals["fs_type"] != "":
            self._format_partition_internal(part_name, vals["fs_type"], vals.get("label", ""))
        else:
            if vals["fs_type"] == "swap":
                self._run_cmd_async(
                    f"mkswap /dev/{part_name}",
                    lambda rc, out, err: self._show_format_result(rc, out, err, part_name)
                )

    def _format_partition(self):
        part = self._get_selected_partition()
        if not part:
            return

        if self._is_running_system_disk():
            self._show_error("Hata", "Calisan sistem diski uzerinde islem yapilamaz.")
            return

        mounted = get_mounted_partitions()
        if part["name"] in mounted:
            self._show_error("Hata", f"/dev/{part['name']} su an bagli. Once baglantiyi kesin.")
            return

        from PyQt6.QtWidgets import QInputDialog
        fs_types = ["ext4", "btrfs", "xfs", "fat32", "ntfs"]
        fs_type, ok = QInputDialog.getItem(
            self, "Dosya Sistemi Sec", f"/dev/{part['name']} icin dosya sistemi:", fs_types, 0, False
        )
        if not ok:
            return

        confirm = self._show_warning(
            "Onay - Bi Formatting",
            f"/dev/{part['name']} uzerindeki tum veriler silinecek ve {fs_type} olarak bi formatlacak.\n\n"
            f"Bu islem geri alinamaz. Devam etmek istediginizden emin misiniz?"
        )
        if confirm != QMessageBox.StandardButton.Yes:
            return

        self._format_partition_internal(part["name"], fs_type, "")

    def _format_partition_internal(self, part_name, fs_type, label=""):
        label_arg = f'-L "{label}"' if label else ""
        if fs_type == "fat32":
            cmd = f"mkfs.vfat -F 32 {label_arg} /dev/{part_name}"
        elif fs_type == "ntfs":
            cmd = f"mkfs.ntfs -f {label_arg} /dev/{part_name}"
        elif fs_type == "btrfs":
            cmd = f"mkfs.btrfs -f {label_arg} /dev/{part_name}"
        elif fs_type == "xfs":
            cmd = f"mkfs.xfs -f {label_arg} /dev/{part_name}"
        elif fs_type == "swap":
            cmd = f"mkswap /dev/{part_name}"
        else:
            cmd = f"mkfs.ext4 -F {label_arg} /dev/{part_name}"

        self._run_cmd_async(cmd, lambda rc, out, err: self._show_format_result(rc, out, err, part_name))

    def _show_format_result(self, rc, out, err, part_name):
        if rc == 0:
            self._show_info("Basarili", f"/dev/{part_name} basariyla bi formatlandi.")
        else:
            self._show_error("Hata", f"Bi formatlama basarisiz:\n{err or out}")

    def _delete_partition(self):
        part = self._get_selected_partition()
        if not part:
            return

        if self._is_running_system_disk():
            self._show_error("Hata", "Calisan sistem diski uzerindeki bol ayrintiler silinemez.")
            return

        mounted = get_mounted_partitions()
        if part["name"] in mounted:
            self._show_error("Hata", f"/dev/{part['name']} bagli. Once baglantiyi kesin.")
            return

        confirm = self._show_warning(
            "Onay - Bolustur Silme",
            f"/dev/{part['name']} kalici olarak silinecek.\n"
            f"Boyut: {part.get('size', 'Bilinmiyor')}\n"
            f"Tur: {part.get('fstype', 'Bilinmiyor')}\n\n"
            f"Bu islem geri alinamaz. Devam etmek istediginizden emin misiniz?"
        )
        if confirm != QMessageBox.StandardButton.Yes:
            return

        # Determine partition number
        part_name = part["name"]
        if self.selected_disk in part_name:
            num = part_name.replace(self.selected_disk, "").replace("p", "")
        else:
            num = re.sub(r"[a-z]+", "", part_name)

        # Use sfdisk to delete
        cmd = f"echo '{num}' | sfdisk --delete /dev/{self.selected_disk}"
        self._run_cmd_async(cmd, lambda rc, out, err: self._on_delete_done(rc, out, err))

    def _on_delete_done(self, rc, out, err):
        if rc == 0:
            run_cmd(f"partprobe /dev/{self.selected_disk}", timeout=10)
            self._show_info("Basarili", "Bol ayrinti basariyla silindi.")
        else:
            self._show_error("Hata", f"Silme basarisiz:\n{err or out}")

    def _mount_partition(self):
        part = self._get_selected_partition()
        if not part:
            return

        if not part.get("fstype"):
            self._show_error("Hata", "Bu bol ayrinti uzerinde dosya sistemi yok.")
            return

        mounted = get_mounted_partitions()
        if part["name"] in mounted:
            # Unmount
            confirm = self._show_warning(
                "Onay - Baglantiyi Kes",
                f"/dev/{part['name']} su an bagli. Baglantiyi kesmek istediginize emin misiniz?"
            )
            if confirm != QMessageBox.StandardButton.Yes:
                return
            cmd = f"umount /dev/{part['name']}"
            self._run_cmd_async(cmd, lambda rc, out, err: self._on_unmount_done(rc, out, err, part["name"]))
        else:
            # Mount
            default_mount = f"/mnt/{part['name']}"
            from PyQt6.QtWidgets import QInputDialog
            mount_point, ok = QInputDialog.getText(
                self, "Bagla", f"/dev/{part['name']} icin mount noktasi:", text=default_mount
            )
            if not ok or not mount_point.strip():
                return
            mount_point = mount_point.strip()

            # Create mount point if it doesn't exist
            run_cmd(f"mkdir -p {mount_point}")

            cmd = f"mount /dev/{part['name']} {mount_point}"
            self._run_cmd_async(cmd, lambda rc, out, err: self._on_mount_done(rc, out, err, mount_point))

    def _on_mount_done(self, rc, out, err, mount_point):
        if rc == 0:
            self._show_info("Basarili", f"Bol ayrinti {mount_point} konumuna baglandi.")
        else:
            self._show_error("Hata", f"Baglama basarisiz:\n{err or out}")

    def _on_unmount_done(self, rc, out, err, part_name):
        if rc == 0:
            self._show_info("Basarili", f"/dev/{part_name} baglantisi kesildi.")
        else:
            self._show_error("Hata", f"Baglanti kesme basarisiz:\n{err or out}")

    def closeEvent(self, event):
        if self._worker and self._worker.isRunning():
            self._worker.terminate()
            self._worker.wait(2000)
        event.accept()


def main():
    app = QApplication(sys.argv)
    app.setStyle("Fusion")

    palette = QPalette()
    palette.setColor(QPalette.ColorRole.Window, QColor(BG_DARK))
    palette.setColor(QPalette.ColorRole.WindowText, QColor(TEXT_PRIMARY))
    palette.setColor(QPalette.ColorRole.Base, QColor(BG_INPUT))
    palette.setColor(QPalette.ColorRole.AlternateBase, QColor(BG_WIDGET))
    palette.setColor(QPalette.ColorRole.ToolTipBase, QColor(BG_WIDGET))
    palette.setColor(QPalette.ColorRole.ToolTipText, QColor(TEXT_PRIMARY))
    palette.setColor(QPalette.ColorRole.Text, QColor(TEXT_PRIMARY))
    palette.setColor(QPalette.ColorRole.Button, QColor(BG_INPUT))
    palette.setColor(QPalette.ColorRole.ButtonText, QColor(TEXT_PRIMARY))
    palette.setColor(QPalette.ColorRole.BrightText, QColor(ACCENT))
    palette.setColor(QPalette.ColorRole.Highlight, QColor(ACCENT))
    palette.setColor(QPalette.ColorRole.HighlightedText, QColor("#ffffff"))
    app.setPalette(palette)

    window = MainWindow()
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
