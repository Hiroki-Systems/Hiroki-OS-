def run_cmd(cmd, timeout=30):
    """Run a command and return (returncode, stdout, stderr)."""
    try:
        result = subprocess.run(
            cmd, shell=True, capture_output=True, text=True, timeout=timeout
        )
        return result.returncode, result.stdout, result.stderr
    except subprocess.TimeoutExpired:
        return -1, "", "Timeout"
    except Exception as e:
        return -1, "", str(e)


def get_disks():
    """Return list of block devices that are disks (not partitions)."""
    rc, out, _ = run_cmd("lsblk -Jd -o NAME,SIZE,MODEL,TYPE")
    if rc != 0:
        return []
    try:
        data = json.loads(out)
        disks = []
        for dev in data.get("blockdevices", []):
            if dev.get("type") == "disk":
                name = dev.get("name", "")
                size = dev.get("size", "")
                model = dev.get("model", "Bilinmeyen").strip()
                disks.append({
                    "name": name,
                    "path": f"/dev/{name}",
                    "size": size,
                    "model": model if model else "Bilinmeyen",
                })
        return disks
    except json.JSONDecodeError:
        return []


def get_partitions(disk_name):
    """Get partitions for a given disk."""
    rc, out, _ = run_cmd(
        f"lsblk -J -o NAME,SIZE,FSTYPE,MOUNTPOINT,TYPE,PARTTYPE,UUID /dev/{disk_name}"
    )
    if rc != 0:
        return []
    try:
        data = json.loads(out)
        partitions = []
        for dev in data.get("blockdevices", []):
            if dev.get("name") != disk_name:
                continue
            for child in dev.get("children", []):
                partitions.append({
                    "name": child.get("name", ""),
                    "size": child.get("size", ""),
                    "fstype": child.get("fstype") or "",
                    "mountpoint": child.get("mountpoint") or "",
                    "type": child.get("type", ""),
                    "parttype": child.get("parttype") or "",
                    "uuid": child.get("uuid") or "",
                })
        return partitions
    except json.JSONDecodeError:
        return []


def get_disk_size_bytes(disk_name):
    """Get disk size in bytes."""
    rc, out, _ = run_cmd(f"blockdev --getsize64 /dev/{disk_name}")
    if rc == 0:
        try:
            return int(out.strip())
        except ValueError:
            pass
    return 0


def bytes_to_human(b):
    """Convert bytes to human readable string."""
    if b <= 0:
        return "0 B"
    units = ["B", "KB", "MB", "GB", "TB"]
    i = 0
    size = float(b)
    while size >= 1024 and i < len(units) - 1:
        size /= 1024
        i += 1
    if i == 0:
        return f"{int(size)} {units[i]}"
    return f"{size:.2f} {units[i]}"


def get_running_disk():
    """Try to identify which disk the root filesystem is on."""
    rc, out, _ = run_cmd("findmnt -n -o SOURCE /")
    if rc == 0:
        dev = out.strip()
        match = re.search(r"/dev/(sd[a-z]+|nvme\d+n\d+|vd[a-z]+|mmcblk\d+)", dev)
        if match:
            dev_name = match.group(1)
            # Strip partition number for whole disk
            # e.g., sda1 -> sda, nvme0n1p1 -> nvme0n1
            if "nvme" in dev_name:
                disk = re.sub(r"p\d+$", "", dev_name)
            else:
                disk = re.sub(r"\d+$", "", dev_name)
            return disk
    return None


def is_mounted(part_name):
    """Check if a partition is currently mounted."""
    rc, out, _ = run_cmd(f"findmnt -n -o SOURCE /dev/{part_name}")
    if rc == 0 and out.strip():
        return True
    rc, out, _ = run_cmd(f"cat /proc/mounts | grep /dev/{part_name} ")
    return rc == 0 and part_name in out


def get_mounted_partitions():
    """Get set of mounted partition device names."""
    mounted = set()
    rc, out, _ = run_cmd("lsblk -Jno NAME,MOUNTPOINT")
    if rc == 0:
        try:
            data = json.loads(out)
            for dev in data.get("blockdevices", []):
                if dev.get("mountpoint"):
                    mounted.add(dev["name"])
                for child in dev.get("children", []):
                    if child.get("mountpoint"):
                        mounted.add(child["name"])
        except json.JSONDecodeError:
            pass
    return mounted


class PartitionBarWidget(QWidget):
    """Custom widget that draws a visual representation of disk partitions."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.partitions = []
        self.disk_size = 0
        self.setMinimumHeight(60)
        self.setMaximumHeight(80)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
        self._selected_index = -1

    def set_partitions(self, partitions, disk_size):
        self.partitions = partitions
        self.disk_size = disk_size
        self.update()

    def set_selected(self, index):
        self._selected_index = index
        self.update()

    def paintEvent(self, event):
        if not self.partitions or self.disk_size <= 0:
            painter = QPainter(self)
            painter.setRenderHint(QPainter.RenderHint.Antialiasing)
            painter.fillRect(self.rect(), QColor(BG_WIDGET))
            painter.setPen(QColor("#555"))
            painter.drawText(self.rect(), Qt.AlignmentFlag.AlignCenter, "Bol ayrinti mevcut degil")
            painter.end()
            return

        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)

        rect = self.rect().adjusted(4, 4, -4, -4)
        painter.setPen(QColor(BORDER_COLOR))
        painter.setBrush(QColor(BG_WIDGET))
        painter.drawRoundedRect(rect, 6, 6)

        x_offset = rect.x() + 2
        total_width = rect.width() - 4
        avail_height = rect.height() - 2
        y_offset = rect.y() + 1

        used_sum = 0
        part_rects = []
        for i, p in enumerate(self.partitions):
            p_bytes = parse_size_to_bytes(p.get("size", "0"))
            if p_bytes <= 0:
                continue
            w = max(1, int((p_bytes / self.disk_size) * total_width))
            r = QRect_helper(x_offset, y_offset, w, avail_height)
            part_rects.append((r, p, i))
            used_sum += p_bytes

        if used_sum < self.disk_size:
            remaining = self.disk_size - used_sum
            w = max(1, int((remaining / self.disk_size) * total_width))
            free_r = QRect_helper(x_offset + sum(pr[0].width() for pr in part_rects) + len(part_rects), y_offset, w, avail_height)
            part_rects.append((free_r, {"name": "Bos Alan", "fstype": "free"}, -1))

        for r, p, idx in part_rects:
            fstype = p.get("fstype", "unknown")
            if fstype == "free":
                color = QColor(PARTITION_COLORS["free"])
            else:
                color = QColor(PARTITION_COLORS.get(fstype, PARTITION_COLORS["unknown"]))

            if idx == self._selected_index:
                color = color.lighter(140)

            painter.fillRect(r, color)
            if idx == self._selected_index:
                painter.setPen(QPen(QColor(ACCENT), 2))
                painter.drawRect(r)

            painter.setPen(QColor("#ffffff"))
            if r.width() > 40:
                font = painter.font()
                font.setPixelSize(10)
                painter.setFont(font)
                label = p.get("name", "")
                painter.drawText(r.adjusted(4, 0, -4, 0),
                                 Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft,
                                 label)
                if r.width() > 90:
                    size_text = p.get("size", "")
                    painter.drawText(r.adjusted(4, 0, -4, 0),
                                     Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignRight,
                                     size_text)

        painter.end()


def QRect_helper(x, y, w, h):
    from PyQt6.QtCore import QRect
    return QRect(x, y, max(1, w), max(1, h))


def parse_size_to_bytes(size_str):
    """Parse a size string like '50G', '512M', '1024K' to bytes."""
    size_str = size_str.strip().upper()
    multipliers = {
        'T': 1024 ** 4,
        'G': 1024 ** 3,
        'M': 1024 ** 2,
        'K': 1024,
        'B': 1,
    }
    for suffix, mult in multipliers.items():
        if size_str.endswith(suffix):
            try:
                return int(float(size_str[:-1]) * mult)
            except ValueError:
                return 0
    try:
        return int(size_str)
    except ValueError:
        return 0


class WorkerThread(QThread):
    """Run a shell command in a background thread."""
    finished = pyqtSignal(int, str, str)

    def __init__(self, cmd, parent=None):
        super().__init__(parent)
        self.cmd = cmd

    def run(self):
        rc, out, err = run_cmd(self.cmd, timeout=120)
        self.finished.emit(rc, out, err)


class CreatePartitionDialog(QDialog):
    """Dialog for creating a new partition."""

    def __init__(self, disk_path, free_space_str, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Yeni Bolustur")
        self.setMinimumWidth(420)
        self.setModal(True)
        self.disk_path = disk_path
        self.free_bytes = parse_size_to_bytes(free_space_str)
        self.free_space_str = free_space_str

        layout = QVBoxLayout(self)
        layout.setSpacing(12)

        header = QLabel("Yeni Bolustur Olustur")
        header.setStyleSheet(f"color: {ACCENT}; font-size: 16px; font-weight: bold;")
        layout.addWidget(header)

        info = QLabel(f"Bos alan: {free_space_str}")
        info.setStyleSheet(f"color: {TEXT_SECONDARY};")
        layout.addWidget(info)

        form = QFormLayout()
        form.setSpacing(10)

        self.size_slider = QSlider(Qt.Orientation.Horizontal)
        self.size_slider.setMinimum(1)
        self.size_slider.setMaximum(1000)
        self.size_slider.setValue(1000)
        self.size_slider.setTickPosition(QSlider.TickPosition.NoTicks)
        self.size_slider.valueChanged.connect(self._update_size_label)

        self.size_label = QLabel(f"{free_space_str} (tum alan)")
        self.size_label.setStyleSheet(f"color: {TEXT_SECONDARY};")

        size_widget = QWidget()
        size_layout = QVBoxLayout(size_widget)
        size_layout.setContentsMargins(0, 0, 0, 0)
        size_layout.addWidget(self.size_slider)
        size_layout.addWidget(self.size_label)
        form.addRow("Boyut (MB):", size_widget)

        self.fs_combo = QComboBox()
        self.fs_combo.addItems(["ext4", "btrfs", "xfs", "fat32", "ntfs", "swap"])
        form.addRow("Dosya Sistemi:", self.fs_combo)

        self.mount_input = QComboBox()
        self.mount_input.setEditable(True)
        self.mount_input.addItems(["", "/mnt", "/home", "/boot", "/data", "/var", "/tmp", "/opt"])
        self.mount_input.setCurrentText("")
        form.addRow("Mount Noktasi:", self.mount_input)

        self.label_input = QComboBox()
        self.label_input.setEditable(True)
        self.label_input.addItems(["", "HirokiOS", "Data", "Backup", "Games", "Work"])
        self.label_input.setCurrentText("")
        form.addRow("Etiket:", self.label_input)

        layout.addLayout(form)

        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        for btn in buttons.buttons():
            if buttons.buttonRole(btn) == QDialogButtonBox.ButtonRole.AcceptRole:
                btn.setObjectName("primaryBtn")
                btn.setText("Olustur")
            else:
                btn.setText("Iptal")
        layout.addWidget(buttons)

        self.setStyleSheet(DARK_STYLE)

    def _update_size_label(self, val):
        if self.free_bytes <= 0:
            return
        mb = int(self.free_bytes / (1024 * 1024) * val / 1000)
        if mb >= 1024:
            gb = mb / 1024
            self.size_label.setText(f"{gb:.2f} GB")
        else:
            self.size_label.setText(f"{mb} MB")

    def get_values(self):
        mb = int(self.free_bytes / (1024 * 1024) * self.size_slider.value() / 1000)
        return {
            "size_mb": mb,
            "fs_type": self.fs_combo.currentText(),
            "mount": self.mount_input.currentText().strip(),
            "label": self.label_input.currentText().strip(),
        }


