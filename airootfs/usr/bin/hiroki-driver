class WorkerThread(QThread):
    progress = pyqtSignal(int, str)
    finished = pyqtSignal(bool, str)

    def __init__(self, packages, action="install"):
        super().__init__()
        self.packages = packages
        self.action = action

    def run(self):
        try:
            if self.action == "install":
                cmd = ["pacman", "-S", "--noconfirm", "--needed"] + self.packages
            else:
                cmd = ["pacman", "-R", "--noconfirm", "--noscriptlet"] + self.packages

            self.progress.emit(10, f"Komut calistiriliyor: {' '.join(cmd)}")

            process = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1
            )

            output_lines = []
            total = len(self.packages) if self.action == "install" else len(self.packages)
            current = 0

            for line in process.stdout:
                line = line.strip()
                if not line:
                    continue
                output_lines.append(line)

                if "installing" in line.lower() or "yukleniyor" in line.lower():
                    current += 1
                    pct = min(90, int((current / max(total, 1)) * 80) + 10)
                    self.progress.emit(pct, line)
                elif "downloading" in line.lower():
                    self.progress.emit(min(60, current * 5 + 10), line)
                elif "checking" in line.lower():
                    self.progress.emit(5, line)
                else:
                    self.progress.emit(min(85, max(10, int(self.progress_sig_val))), line)

            process.wait()

            if process.returncode == 0:
                self.progress.emit(100, "Islem basarili!")
                self.finished.emit(True, "\n".join(output_lines[-10:]))
            else:
                err = "\n".join(output_lines[-20:])
                self.finished.emit(False, f"Hata (kod {process.returncode}):\n{err}")

        except FileNotFoundError:
            self.finished.emit(False, "HATA: pacman bulunamadi. Root yetkisi gerekebilir.")
        except Exception as e:
            self.finished.emit(False, f"Beklenmeyen hata: {str(e)}")

    @property
    def progress_sig_val(self):
        return 50


class GPUInfo:
    GPU_TYPE_UNKNOWN = "unknown"
    GPU_TYPE_NVIDIA = "nvidia"
    GPU_TYPE_AMD = "amd"
    GPU_TYPE_INTEL = "intel"

    DRIVER_MAP = {
        GPU_TYPE_NVIDIA: [
            {"name": "NVIDIA (Proprietary)", "pkg": "nvidia", "desc": "NVIDIA ozel surucu"},
            {"name": "NVIDIA DKMS", "pkg": "nvidia-dkms", "desc": "NVIDIA DKMS tabanli surucu"},
            {"name": "NVIDIA Yardimci", "pkg": "nvidia-utils", "desc": "NVIDIA yardimci araclari"},
            {"name": "NVIDIA 32-bit", "pkg": "lib32-nvidia-utils", "desc": "32-bit NVIDIA destegi (Wine/Steam)"},
        ],
        GPU_TYPE_AMD: [
            {"name": "Mesa (AMD)", "pkg": "mesa", "desc": "Mesa OpenGL/Vulkan AMD destegi"},
            {"name": "Vulkan Radeon", "pkg": "vulkan-radeon", "desc": "AMD Vulkan surucu (RADV)"},
            {"name": "AMDGPU Xorg", "pkg": "xf86-video-amdgpu", "desc": "AMD Xorg surucu"},
            {"name": "Mesa 32-bit", "pkg": "lib32-mesa", "desc": "32-bit Mesa destegi (Wine/Steam)"},
        ],
        GPU_TYPE_INTEL: [
            {"name": "Mesa (Intel)", "pkg": "mesa", "desc": "Mesa OpenGL/Vulkan Intel destegi"},
            {"name": "Vulkan Intel", "pkg": "vulkan-intel", "desc": "Intel Vulkan surucu (ANV)"},
            {"name": "Intel Xorg", "pkg": "xf86-video-intel", "desc": "Intel Xorg surucu"},
            {"name": "Mesa 32-bit", "pkg": "lib32-mesa", "desc": "32-bit Mesa destegi (Wine/Steam)"},
        ],
    }

    @staticmethod
    def detect_gpu():
        try:
            result = subprocess.run(
                ["lspci"],
                capture_output=True, text=True, timeout=5
            )
            for line in result.stdout.splitlines():
                lower = line.lower()
                if "vga" in lower or "3d" in lower or "display" in lower:
                    if "nvidia" in lower or "geforce" in lower or "quadro" in lower or "tesla" in lower or "rtx" in lower or "gtx" in lower:
                        return line.strip(), GPUInfo.GPU_TYPE_NVIDIA
                    elif "amd" in lower or "ati" in lower or "radeon" in lower or "navi" in lower or "rdna" in lower:
                        return line.strip(), GPUInfo.GPU_TYPE_AMD
                    elif "intel" in lower or "uhd" in lower or "iris" in lower or "hd graphics" in lower:
                        return line.strip(), GPUInfo.GPU_TYPE_INTEL
                    else:
                        return line.strip(), GPUInfo.GPU_TYPE_UNKNOWN
        except Exception:
            pass
        return "GPU tespit edilemedi", GPUInfo.GPU_TYPE_UNKNOWN

    @staticmethod
    def get_gpu_type_label(gpu_type):
        labels = {
            GPUInfo.GPU_TYPE_NVIDIA: "NVIDIA",
            GPUInfo.GPU_TYPE_AMD: "AMD / Radeon",
            GPUInfo.GPU_TYPE_INTEL: "Intel",
            GPUInfo.GPU_TYPE_UNKNOWN: "Bilinmeyen",
        }
        return labels.get(gpu_type, "Bilinmeyen")

    @staticmethod
    def is_package_installed(pkg):
        try:
            result = subprocess.run(
                ["pacman", "-Qi", pkg],
                capture_output=True, text=True, timeout=5
            )
            return result.returncode == 0
        except Exception:
            return False

    @staticmethod
    def get_package_version(pkg):
        try:
            result = subprocess.run(
                ["pacman", "-Qi", pkg],
                capture_output=True, text=True, timeout=5
            )
            for line in result.stdout.splitlines():
                if line.startswith("Version"):
                    return line.split(":", 1)[1].strip()
        except Exception:
            pass
        return "-"

    @staticmethod
    def get_available_version(pkg):
        try:
            result = subprocess.run(
                ["pacman", "-Si", pkg],
                capture_output=True, text=True, timeout=5
            )
            for line in result.stdout.splitlines():
                if line.startswith("Version"):
                    return line.split(":", 1)[1].strip()
        except Exception:
            pass
        return "-"


class HeaderWidget(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFixedHeight(80)
        self.layout = QVBoxLayout(self)
        self.layout.setContentsMargins(20, 12, 20, 8)

        title = QLabel("Hiroki OS")
        title.setStyleSheet(f"font-size: 20px; font-weight: bold; color: {ACCENT}; letter-spacing: 1px;")
        self.layout.addWidget(title)

        subtitle = QLabel("Surucu Yoneticisi")
        subtitle.setStyleSheet(f"font-size: 14px; color: {TEXT_SECONDARY}; font-weight: normal; margin-top: -2px;")
        self.layout.addWidget(subtitle)

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        grad = QLinearGradient(0, 0, self.width(), 0)
        grad.setColorAt(0, QColor(ACCENT))
        grad.setColorAt(1, QColor("#a02060"))
        painter.setPen(Qt.PenStyle.NoPen)
        painter.setBrush(grad)
        painter.drawRect(0, self.height() - 2, self.width(), 2)
        painter.end()


class GPUDisplayWidget(QGroupBox):
    def __init__(self, parent=None):
        super().__init__("Tespit Edilen GPU", parent)
        self.layout = QVBoxLayout(self)

        self.gpu_name_label = QLabel("Taranıyor...")
        self.gpu_name_label.setStyleSheet(f"font-size: 15px; font-weight: bold; color: {TEXT_PRIMARY};")
        self.gpu_name_label.setWordWrap(True)
        self.layout.addWidget(self.gpu_name_label)

        self.gpu_type_label = QLabel("")
        self.gpu_type_label.setStyleSheet(f"font-size: 12px; color: {ACCENT}; font-weight: bold;")
        self.layout.addWidget(self.gpu_type_label)

        info_layout = QHBoxLayout()
        self.status_dot = QLabel("●")
        self.status_dot.setStyleSheet(f"color: {ORANGE}; font-size: 14px;")
        info_layout.addWidget(self.status_dot)

        self.status_label = QLabel("Taraniyor...")
        self.status_label.setStyleSheet(f"font-size: 12px; color: {TEXT_SECONDARY};")
        info_layout.addWidget(self.status_label)
        info_layout.addStretch()

        self.layout.addLayout(info_layout)

    def set_gpu(self, name, gpu_type):
        self.gpu_name_label.setText(name)
        type_label = GPUInfo.get_gpu_type_label(gpu_type)
        self.gpu_type_label.setText(f"Tur: {type_label}")

        if gpu_type != GPUInfo.GPU_TYPE_UNKNOWN:
            self.status_dot.setStyleSheet(f"color: {GREEN}; font-size: 14px;")
            self.status_label.setText("GPU basariyla tespit edildi")
        else:
            self.status_dot.setStyleSheet(f"color: {RED}; font-size: 14px;")
            self.status_label.setText("GPU turu taninamadi - genel suruculer gosteriliyor")


class DriverTableWidget(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.layout = QVBoxLayout(self)
        self.layout.setContentsMargins(0, 0, 0, 0)

        self.table = QTableWidget()
        self.table.setColumnCount(5)
        self.table.setHorizontalHeaderLabels(["Durum", "Surucu Adi", "Paket", "Surum", "Aciklama"])
        self.table.horizontalHeader().setSectionResizeMode(0, QHeaderView.ResizeMode.Fixed)
        self.table.horizontalHeader().resizeSection(0, 70)
        self.table.horizontalHeader().setSectionResizeMode(1, QHeaderView.ResizeMode.Stretch)
        self.table.horizontalHeader().setSectionResizeMode(2, QHeaderView.ResizeMode.Fixed)
        self.table.horizontalHeader().resizeSection(2, 160)
        self.table.horizontalHeader().setSectionResizeMode(3, QHeaderView.ResizeMode.Fixed)
        self.table.horizontalHeader().resizeSection(3, 130)
        self.table.horizontalHeader().setSectionResizeMode(4, QHeaderView.ResizeMode.Stretch)
        self.table.setSelectionBehavior(QTableWidget.SelectionBehavior.SelectRows)
        self.table.setAlternatingRowColors(True)
        self.table.setShowGrid(False)
        self.table.verticalHeader().setVisible(False)
        self.table.setEditTriggers(QTableWidget.EditTrigger.NoEditTriggers)

        self.table.setStyleSheet(f"""
            QTableWidget {{
                alternate-background-color: #141414;
            }}
        """)

        self.layout.addWidget(self.table)
        self.driver_data = []
        self.selected_packages = set()

    def populate(self, drivers):
        self.table.setRowCount(0)
        self.table.setRowCount(len(drivers))
        self.driver_data = drivers
        self.selected_packages = set()

        for row, drv in enumerate(drivers):
            installed = GPUInfo.is_package_installed(drv["pkg"])
            version = GPUInfo.get_package_version(drv["pkg"]) if installed else "-"
            avail = GPUInfo.get_available_version(drv["pkg"])

            status_item = QTableWidgetItem()
            if installed:
                status_item.setText("Yuklu")
                status_item.setForeground(QBrush(QColor(GREEN)))
            else:
                status_item.setText("Yuklu Degil")
                status_item.setForeground(QBrush(QColor(TEXT_MUTED)))

            name_item = QTableWidgetItem(drv["name"])
            name_item.setFont(QFont("Segoe UI", 12, QFont.Weight.Bold))

            pkg_item = QTableWidgetItem(drv["pkg"])
            pkg_item.setForeground(QBrush(QColor(ACCENT)))

            ver_text = f"{version}" if installed else f"{avail}"
            ver_item = QTableWidgetItem(ver_text)
            if installed:
                ver_item.setForeground(QBrush(QColor(GREEN)))
            else:
                ver_item.setForeground(QBrush(QColor(TEXT_SECONDARY)))

            desc_item = QTableWidgetItem(drv["desc"])
            desc_item.setForeground(QBrush(QBrush(QColor(TEXT_SECONDARY))))

            self.table.setItem(row, 0, status_item)
            self.table.setItem(row, 1, name_item)
            self.table.setItem(row, 2, pkg_item)
            self.table.setItem(row, 3, ver_item)
            self.table.setItem(row, 4, desc_item)

            self.table.setRowHeight(row, 44)

    def get_selected_packages(self):
        packages = []
        for idx in self.table.selectionModel().selectedRows():
            row = idx.row()
            if row < len(self.driver_data):
                packages.append(self.driver_data[row]["pkg"])
        return packages

    def get_installed_packages(self):
        pkgs = []
        for drv in self.driver_data:
            if GPUInfo.is_package_installed(drv["pkg"]):
                pkgs.append(drv["pkg"])
        return pkgs


class LogWidget(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.layout = QVBoxLayout(self)
        self.layout.setContentsMargins(0, 0, 0, 0)

        header = QLabel("Islem Logu")
        header.setStyleSheet(f"font-weight: bold; color: {ACCENT}; font-size: 12px; margin-bottom: 4px;")
        self.layout.addWidget(header)

        self.log_text = QTextEdit()
        self.log_text.setReadOnly(True)
        self.log_text.setMinimumHeight(100)
        self.layout.addWidget(self.log_text)

        clear_btn = QPushButton("Logu Temizle")
        clear_btn.setFixedWidth(110)
        clear_btn.clicked.connect(self.log_text.clear)
        btn_layout = QHBoxLayout()
        btn_layout.addStretch()
        btn_layout.addWidget(clear_btn)
        self.layout.addLayout(btn_layout)

    def append(self, text, color=TEXT_SECONDARY):
        self.log_text.setTextColor(QColor(color))
        self.log_text.append(text)
        self.log_text.verticalScrollBar().setValue(
            self.log_text.verticalScrollBar().maximum()
        )


