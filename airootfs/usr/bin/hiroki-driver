        quit_btn.setFixedWidth(90)
        quit_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        quit_btn.clicked.connect(self.close)
        bottom_bar.addWidget(quit_btn)

        content_layout.addLayout(bottom_bar)
        main_layout.addWidget(content)

        self.log_widget.append("Hiroki OS Surucu Yoneticisi baslatildi.", ACCENT)
        self.log_widget.append("GPU taranıyor...", TEXT_SECONDARY)

        QTimer.singleShot(200, self.detect_gpu)

    def detect_gpu(self):
        self.gpu_name, self.gpu_type = GPUInfo.detect_gpu()
        self.gpu_display.set_gpu(self.gpu_name, self.gpu_type)

        self.log_widget.append(f"GPU: {self.gpu_name}", TEXT_PRIMARY)
        self.log_widget.append(f"Tur: {GPUInfo.get_gpu_type_label(self.gpu_type)}", ACCENT)

        drivers = GPUInfo.DRIVER_MAP.get(self.gpu_type, [])
        if not drivers:
            self.log_widget.append("Bu GPU icin tanimli surucu bulunamadi.", ORANGE)
            self.summary_label.setText("Surucu bulunamadi")
            return

        self.driver_table.populate(drivers)

        installed = self.driver_table.get_installed_packages()
        total = len(drivers)
        self.summary_label.setText(
            f"{total} surucu bulundu | {len(installed)} yuklu | {total - len(installed)} yuklu degil"
        )

        self.log_widget.append(
            f"{len(drivers)} surucu listelendi, {len(installed)} tanesi yuklu.",
            GREEN if installed else TEXT_SECONDARY
        )

    def install_selected(self):
        packages = self.driver_table.get_selected_packages()
        if not packages:
            QMessageBox.information(
                self, "Bilgi",
                "Lutfen kurmak istediginiz surucuyu tablodan secin.\n"
                "Birden fazla surucu secmek icin Ctrl tusuna basili tutarak tiklayabilirsiniz."
            )
            return

        missing = []
        for pkg in packages:
            if not GPUInfo.is_package_installed(pkg):
                missing.append(pkg)

        if not missing:
            QMessageBox.information(
                self, "Bilgi",
                "Secili suruculer zaten yuklu."
            )
            return

        reply = QMessageBox.question(
            self, "Onay",
            f"Asagidaki paketler kurulacak:\n\n"
            f"  {chr(10).join('  - ' + p for p in missing)}\n\n"
            f"Devam etmek istediginize emin misiniz?",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
            QMessageBox.StandardButton.Yes
        )

        if reply == QMessageBox.StandardButton.Yes:
            self.run_operation(missing, "install")

    def remove_selected(self):
        packages = self.driver_table.get_selected_packages()
        if not packages:
            QMessageBox.information(
                self, "Bilgi",
                "Lutfen kaldirilacak surucuyu tablodan secin."
            )
            return

        installed = [p for p in packages if GPUInfo.is_package_installed(p)]
        if not installed:
            QMessageBox.information(
                self, "Bilgi",
                "Secili suruculer zaten yuklu degil."
            )
            return

        reply = QMessageBox.warning(
            self, "Dikkat",
            f"Asagidaki paketler kaldirilacak:\n\n"
            f"  {chr(10).join('  - ' + p for p in installed)}\n\n"
            f"Kaldirma islemi sistemi bozabilir!\n"
            f"Devam etmek istediginize emin misiniz?",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
            QMessageBox.StandardButton.No
        )

        if reply == QMessageBox.StandardButton.Yes:
            self.run_operation(installed, "remove")

    def run_operation(self, packages, action):
        if self.worker and self.worker.isRunning():
            QMessageBox.warning(self, "Uyari", "Bir islem zaten devam ediyor.")
            return

        self.install_btn.setEnabled(False)
        self.remove_btn.setEnabled(False)
        self.detect_btn.setEnabled(False)

        self.progress_bar.setVisible(True)
        self.progress_bar.setValue(0)
        self.status_label.setVisible(True)
        self.status_label.setText("Islem baslatiliyor...")

        action_label = "kuruluyor" if action == "install" else "kaldiriliyor"
        self.log_widget.append(
            f"Islem baslatiliyor: {', '.join(packages)} {action_label}",
            ORANGE if action == "remove" else BLUE
        )

        self.worker = WorkerThread(packages, action)
        self.worker.progress.connect(self.on_progress)
        self.worker.finished.connect(self.on_finished)
        self.worker.start()

    def on_progress(self, value, message):
        self.progress_bar.setValue(value)
        self.status_label.setText(message)
        if message:
            self.log_widget.append(f"  {message}", TEXT_SECONDARY)

    def on_finished(self, success, message):
        self.install_btn.setEnabled(True)
        self.remove_btn.setEnabled(True)
        self.detect_btn.setEnabled(True)

        if success:
            self.progress_bar.setValue(100)
            self.status_label.setText("Islem basariyla tamamlandi!")
            self.log_widget.append("Islem basariyla tamamlandi.", GREEN)
            self.needs_reboot = True
            self.reboot_btn.setVisible(True)

            QMessageBox.information(
                self, "Basarili",
                "Surucu islemi basariyla tamamlandi!\n\n"
                "Degisikliklerin tam olarak uygulanmasi icin\n"
                "sistemi yeniden baslatmaniz onerilir."
            )

            self.detect_gpu()
        else:
            self.status_label.setText("Islem basarisiz!")
            self.log_widget.append(f"HATA: {message}", RED)

            QMessageBox.critical(
                self, "Hata",
                f"Islem basarisiz oldu:\n\n{message[:500]}"
            )

        QTimer.singleShot(3000, self.reset_progress)

    def reset_progress(self):
        self.progress_bar.setVisible(False)
        self.status_label.setVisible(False)

    def reboot_system(self):
        reply = QMessageBox.question(
            self, "Yeniden Baslatma",
            "Sistem yeniden baslatilacak.\n"
            "Tum kaydedilmemis islemler kaybolacaktir.\n\n"
            "Devam etmek istediginize emin misiniz?",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
            QMessageBox.StandardButton.No
        )

        if reply == QMessageBox.StandardButton.Yes:
            self.log_widget.append("Sistem yeniden baslatiliyor...", ORANGE)
            try:
                subprocess.run(["systemctl", "reboot"], timeout=5)
            except Exception:
                try:
                    subprocess.run(["reboot"], timeout=5)
                except Exception as e:
                    QMessageBox.critical(
                        self, "Hata",
                        f"Yeniden baslatma basarisiz: {str(e)}\n"
                        f"Lutfen terminalden 'reboot' komutunu calistirin."
                    )


def main():
    app = QApplication(sys.argv)
    app.setStyleSheet(STYLESHEET)

    palette = QPalette()
    palette.setColor(QPalette.ColorRole.Window, QColor(BG_DARK))
    palette.setColor(QPalette.ColorRole.WindowText, QColor(TEXT_PRIMARY))
    palette.setColor(QPalette.ColorRole.Base, QColor(BG_CARD))
    palette.setColor(QPalette.ColorRole.AlternateBase, QColor("#141414"))
    palette.setColor(QPalette.ColorRole.ToolTipBase, QColor(BG_CARD))
    palette.setColor(QPalette.ColorRole.ToolTipText, QColor(TEXT_PRIMARY))
    palette.setColor(QPalette.ColorRole.Text, QColor(TEXT_PRIMARY))
    palette.setColor(QPalette.ColorRole.Button, QColor(BG_CARD))
    palette.setColor(QPalette.ColorRole.ButtonText, QColor(TEXT_PRIMARY))
    palette.setColor(QPalette.ColorRole.BrightText, QColor(ACCENT))
    palette.setColor(QPalette.ColorRole.Link, QColor(ACCENT))
    palette.setColor(QPalette.ColorRole.Highlight, QColor(ACCENT))
    palette.setColor(QPalette.ColorRole.HighlightedText, QColor("#ffffff"))
    app.setPalette(palette)

    window = MainWindow()
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
