[Icon Theme]
Name=Hiroki-Icons
Comment=Hiroki OS ikon teması - Papirus Dark tabanlı, mor klasörler (#2D1B69)
Inherits=Papirus-Dark,breeze-dark,Adwaita,gnome,hicolor
Example=folder

# Hiroki özelleştirmesi: klasörler mor (#2D1B69), vurgu pembe (#E91E8C)
# Papirus ikonları üzerine Hiroki renk paleti uygulanır
# Orijinal Papirus Dark ikonları mor tonlarıyla yeniden renklendirilmiştir

Directories=16x16/places,22x22/places,24x24/places,32x32/places,48x48/places,64x64/places

[16x16/places]
Size=16
Context=Places
Type=Fixed

[22x22/places]
